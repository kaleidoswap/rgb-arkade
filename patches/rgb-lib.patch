+//! [rgb-arkade] Self-contained Ark proofs for unmined RGB witnesses.
+//!
+//! A proof (`*.arkproof.json`, sidecar of a consignment) lists the RGB witness txids that are
+//! Arkade virtual txs (checkpoint, ark tx, forfeit) and the PSBTs of every virtual tx needed to
+//! link them to a *mined* tx (normally a batch commitment tx). Verification uses only the proof
+//! and the blockchain resolver, never arkd:
+//! - each bundled PSBT's txid is recomputed; every input spends either a bundled tx (checked
+//!   recursively) or a mined tx (resolver: `Mined`); the referenced output must exist;
+//! - signatures: key-path `tap_key_sig` (batch-tree nodes, MuSig of cosigners + operator) and
+//!   script-path `tap_script_sigs` (checkpoint, ark tx, forfeit VTXO input) are verified with
+//!   BIP-341 sighashes over the prevouts taken from the parent txs (never from PSBT fields). A
+//!   script-path input needs a leaf whose control block commits to the prevout key and in which
+//!   *every* `CHECKSIG(VERIFY)` key has a valid signature. Sighash must be DEFAULT or ALL;
+//! - a listed witness with a fully signed operator leaf on one input (a forfeit: VTXO input
+//!   co-signed by user + operator, arkd forfeit-cosign change) may spend an unsigned, operator-only branch on
+//!   its other input (the connector branch), which is checked by txid linkage only: the signed
+//!   input's SIGHASH_DEFAULT commits to the connector outpoint, so the operator's co-signature
+//!   binds the forfeit to that connector of the mined commitment tx;
+//! - in strict mode the satisfied tapleaf must contain a pinned operator key (signer/forfeit key), so a
+//!   user-only leaf (e.g. the CSV exit leaf) cannot fake an operator-acknowledged spend;
+//! - every listed witness has at least one such operator leaf: key-path signatures alone do not count;
+//! - every listed witness has exactly one OP_RETURN: index 0, 0 sat, `OP_RETURN PUSH32`.
+//!
+//! The anchor of a witness is its highest mined ancestor (the most recent batch commitment).
+use super::*;
+
+use bdk_wallet::bitcoin::{
+    OutPoint as ProofOutPoint, Psbt as ProofPsbt, ScriptBuf as ProofScript, Transaction as ProofTx, TxOut as ProofTxOut,
+    Txid as ProofTxid,
+    key::{Secp256k1 as ProofSecp, XOnlyPublicKey as ProofXOnly},
+    opcodes::all::{OP_CHECKSIG, OP_CHECKSIGVERIFY},
+    script::Instruction,
+    secp256k1::{Message as ProofMessage, Verification},
+    sighash::{Prevouts, SighashCache, TapSighashType},
+    taproot::TapLeafHash,
+};
+
+/// Sidecar file suffix appended to the consignment path.
+pub const ARK_PROOF_SUFFIX: &str = ".arkproof.json";
+
+/// Self-contained Ark proof bundle (JSON sidecar of a consignment).
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct ArkProof {
+    /// Format version (1).
+    pub version: u8,
+    /// RGB witness txids that are unmined Arkade virtual txs.
+    pub witnesses: Vec<String>,
+    /// Base64 PSBTs of the witnesses and of every unmined ancestor down to a mined tx.
+    pub psbts: Vec<String>,
+    /// [rgb-arkade] Witnesses (forfeit txids) claimed to be *sweep recoveries*: accepted only if the
+    /// chain shows that the forfeited VTXO's branch was swept (a mined ancestor output spent by
+    /// a tx that is not the next branch tx), so the VTXO can never be published on-chain.
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub recoveries: Vec<String>,
+    /// [rgb-arkade] VTXO outpoints (`txid:vout`) whose branch PSBTs are bundled, so that the
+    /// receiver can track their liveness (active / swept -> to recover / unrolled) from the chain.
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub vtxos: Vec<String>,
+}
+
+/// [rgb-arkade] A mined outpoint a VTXO's branch hangs from, and the bundled tx that spends it.
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+pub struct ArkAnchor {
+    /// Mined outpoint (`txid:vout`), normally a batch output of a commitment tx.
+    pub outpoint: String,
+    /// Its script (hex), for the indexer lookup.
+    pub script_pubkey: String,
+    /// The branch tx that spends it (if the chain shows another spender, the branch was swept).
+    pub child: String,
+}
+
+/// [rgb-arkade] Chain lookup: spender of a mined outpoint -> (spending txid, confirmed).
+pub(crate) type SpenderFn<'a> =
+    &'a dyn Fn(ProofOutPoint, &ProofScript) -> Result<Option<(ProofTxid, bool)>, String>;
+
+/// [rgb-arkade] Liveness of a colored VTXO, derived from the chain only.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub enum ArkVtxoStatus {
+    /// Branch not swept, VTXO not on-chain: spendable off-chain.
+    Active,
+    /// The VTXO tx is mined (unilateral exit): spend it on-chain.
+    Unrolled,
+    /// The batch was swept: the RGB state is frozen until a recovery forfeit moves it.
+    ToRecover {
+        /// The tx that swept the branch.
+        sweep_txid: String,
+    },
+    /// This wallet already moved the state (pending until the batch/witness settles).
+    Spent {
+        /// The witness that consumed it.
+        by: String,
+    },
+}
+
+/// [rgb-arkade] Ark-aware balance of one asset: state on tracked VTXOs, by liveness.
+#[derive(Debug, Clone, Default, Serialize, Deserialize)]
+pub struct ArkAssetBalance {
+    /// On active VTXOs (spendable off-chain).
+    pub active: u64,
+    /// On swept VTXOs: frozen until recovered.
+    pub to_recover: u64,
+    /// On unrolled (mined) VTXOs.
+    pub unrolled: u64,
+    /// On VTXOs already spent by this wallet (in flight).
+    pub in_flight: u64,
+    /// Per VTXO: (outpoint, amount, status).
+    pub vtxos: Vec<(String, u64, ArkVtxoStatus)>,
+}
+
+/// [rgb-arkade] A tracked VTXO (wallet dir `ark_vtxos.json`).
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct ArkVtxoRecord {
+    /// `txid:vout`.
+    pub outpoint: String,
+    /// Mined outpoints the branch hangs from.
+    pub anchors: Vec<ArkAnchor>,
+    /// Bundled branch txids.
+    pub branch: Vec<String>,
+    /// Witness of this wallet that consumed the state on it.
+    pub spent_by: Option<String>,
+    /// Owned by this wallet (received or declared): only owned VTXOs count in the balance.
+    #[serde(default)]
+    pub owned: bool,
+}
+
+/// [rgb-arkade] A custom-colored (Arkade) transfer made by this wallet (`ark_transfers.json`).
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct ArkTransferRecord {
+    /// Witness txid (checkpoint, ark tx, forfeit or on-chain tx).
+    pub witness: String,
+    /// Asset (contract) ID.
+    pub asset_id: String,
+    /// Consumed outpoints.
+    pub inputs: Vec<String>,
+    /// (seal, amount): `txid:vout` for explicit seals, `witness:vout` for witness vouts.
+    pub outputs: Vec<(String, u64)>,
+    /// Unix time.
+    pub created_at: u64,
+    /// `pending`, `attested` (verified Ark proof imported) or `rolled_back`.
+    pub status: String,
+}
+
+/// [rgb-arkade] Full verification result.
+pub(crate) struct ArkProofVerified {
+    pub witnesses: VerifiedArkWitnesses,
+    /// vtxo outpoint -> (anchors, branch txids)
+    pub vtxos: HashMap<String, (Vec<ArkAnchor>, Vec<String>)>,
+    /// (recovery forfeit txid, sweep txid)
+    pub recoveries: Vec<(String, String)>,
+}
+
+/// [rgb-arkade] Two operator-co-signed forfeits spending the same VTXO (publishable evidence).
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct ArkFraudProof {
+    /// Format version (1).
+    pub version: u8,
+    /// The double-forfeited VTXO (`txid:vout`).
+    pub vtxo: String,
+    /// First forfeit txid and its self-contained proof.
+    pub forfeit_a: String,
+    /// Proof bundle of the first forfeit.
+    pub proof_a: ArkProof,
+    /// Second forfeit txid.
+    pub forfeit_b: String,
+    /// Proof bundle of the second forfeit.
+    pub proof_b: ArkProof,
+}
+
+/// [rgb-arkade] What a valid fraud proof establishes.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct ArkFraudEvidence {
+    /// The VTXO spent twice.
+    pub vtxo: String,
+    /// The two conflicting forfeit txids.
+    pub forfeits: [String; 2],
+    /// Their anchors (mined commitment txs).
+    pub anchors: [String; 2],
+    /// Operator key(s) whose signature appears on both conflicting spends.
+    pub operator_keys: Vec<String>,
+}
+
+/// Result: witness txid -> (unsigned tx, anchor txid).
+pub(crate) type VerifiedArkWitnesses = HashMap<String, (BdkTransaction, String)>;
+
+#[derive(Clone, Copy, PartialEq, Eq, Hash)]
+enum Mode {
+    Strict,
+    LinkageOnly,
+}
+
+struct Verifier<'a, R: ResolveWitness> {
+    bundle: HashMap<ProofTxid, ProofPsbt>,
+    witnesses: HashSet<ProofTxid>,
+    resolver: &'a R,
+    operators: Vec<ProofXOnly>,
+    // txid -> (anchor txid, anchor height)
+    memo: HashMap<(ProofTxid, Mode), (ProofTxid, u32)>,
+}
+
+fn checksig_pubkeys(script: &ProofScript) -> Vec<ProofXOnly> {
+    let ins: Vec<_> = script.instructions().filter_map(|i| i.ok()).collect();
+    let mut out = vec![];
+    for w in ins.windows(2) {
+        if let (Instruction::PushBytes(b), Instruction::Op(op)) = (&w[0], &w[1]) {
+            if (*op == OP_CHECKSIG || *op == OP_CHECKSIGVERIFY) && b.len() == 32 {
+                if let Ok(pk) = ProofXOnly::from_slice(b.as_bytes()) {
+                    out.push(pk);
+                }
+            }
+        }
+    }
+    out
+}
+
+fn p2tr_key(spk: &ProofScript) -> Result<ProofXOnly, String> {
+    if !spk.is_p2tr() {
+        return Err(format!("prevout {spk} is not P2TR"));
+    }
+    ProofXOnly::from_slice(&spk.as_bytes()[2..34]).map_err(|e| e.to_string())
+}
+
+fn check_sighash_type(t: TapSighashType) -> Result<(), String> {
+    match t {
+        TapSighashType::Default | TapSighashType::All => Ok(()),
+        other => Err(format!("sighash type {other} does not commit to the whole tx")),
+    }
+}
+
+fn verify_schnorr<C: Verification>(
+    secp: &ProofSecp<C>,
+    sig: &bdk_wallet::bitcoin::taproot::Signature,
+    digest: [u8; 32],
+    pk: &ProofXOnly,
+) -> Result<(), String> {
+    let msg = ProofMessage::from_digest(digest);
+    secp.verify_schnorr(&sig.signature, &msg, pk)
+        .map_err(|e| format!("invalid signature: {e}"))
+}
+
+pub(crate) fn opret_layout_ok(tx: &ProofTx) -> Result<(), String> {
+    let oprets = tx.output.iter().filter(|o| o.script_pubkey.is_op_return()).count();
+    let o0 = tx.output.first().ok_or("no outputs")?;
+    let b = o0.script_pubkey.as_bytes();
+    if oprets != 1 || !o0.script_pubkey.is_op_return() || o0.value.to_sat() != 0 || b.len() != 34
+        || b[1] != 0x20
+    {
+        return Err(format!(
+            "witness {} lacks a single 0-sat OP_RETURN<32B> at index 0",
+            tx.compute_txid()
+        ));
+    }
+    Ok(())
+}
+
+impl<R: ResolveWitness> Verifier<'_, R> {
+    /// [rgb-arkade] Mined outpoints the bundled tx `txid` hangs from, plus the bundled branch txids.
+    fn anchors(&self, txid: ProofTxid) -> Result<(Vec<ArkAnchor>, Vec<String>), String> {
+        let mut anchors = vec![];
+        let mut branch = vec![];
+        let mut stack = vec![txid];
+        let mut seen = HashSet::new();
+        while let Some(t) = stack.pop() {
+            if !seen.insert(t) {
+                continue;
+            }
+            let p = self.bundle.get(&t).ok_or_else(|| format!("tx {t} missing from the proof"))?;
+            branch.push(t.to_string());
+            for i in &p.unsigned_tx.input {
+                let prev = i.previous_output;
+                if self.bundle.contains_key(&prev.txid) {
+                    stack.push(prev.txid);
+                } else {
+                    let (out, _) = self.mined_output(prev.txid, prev.vout)?;
+                    anchors.push(ArkAnchor {
+                        outpoint: prev.to_string(),
+                        script_pubkey: out.script_pubkey.to_hex_string(),
+                        child: t.to_string(),
+                    });
+                }
+            }
+        }
+        Ok((anchors, branch))
+    }
+
+    fn mined_output(&self, txid: ProofTxid, vout: u32) -> Result<(ProofTxOut, u32), String> {
+        let rtxid = RgbTxid::from_str(&txid.to_string()).map_err(|e| e.to_string())?;
+        match self.resolver.resolve_witness(rtxid) {
+            Ok(WitnessStatus::Resolved(tx, WitnessOrd::Mined(pos))) => {
+                let out = tx
+                    .output
+                    .get(vout as usize)
+                    .cloned()
+                    .ok_or_else(|| format!("mined tx {txid} has no output {vout}"))?;
+                Ok((out, pos.height().get()))
+            }
+            Ok(_) => Err(format!(
+                "tx {txid} is neither in the proof nor mined (missing branch tx or unmined commitment tx)"
+            )),
+            Err(e) => Err(format!("resolver error for {txid}: {e}")),
+        }
+    }
+
+    fn check(&mut self, txid: ProofTxid, mode: Mode) -> Result<(ProofTxid, u32), String> {
+        if let Some(a) = self.memo.get(&(txid, mode)) {
+            return Ok(*a);
+        }
+        let psbt = self
+            .bundle
+            .get(&txid)
+            .cloned()
+            .ok_or_else(|| format!("tx {txid} missing from the proof"))?;
+        let tx = &psbt.unsigned_tx;
+        let is_witness = self.witnesses.contains(&txid);
+        // which inputs carry signatures
+        let signed: Vec<bool> = psbt
+            .inputs
+            .iter()
+            .map(|i| i.tap_key_sig.is_some() || !i.tap_script_sigs.is_empty())
+            .collect();
+        let script_signed: Vec<bool> =
+            psbt.inputs.iter().map(|i| !i.tap_script_sigs.is_empty()).collect();
+        let mut prevouts = vec![];
+        let mut anchor: Option<(ProofTxid, u32)> = None;
+        for (idx, inp) in tx.input.iter().enumerate() {
+            let prev = inp.previous_output;
+            // a witness whose *other* input is a fully signed operator leaf (a forfeit: VTXO
+            // input co-signed by user + operator) may spend an unsigned, operator-only branch
+            // (the connector branch), checked by txid linkage only
+            let vouched = is_witness
+                && script_signed.iter().enumerate().any(|(j, s)| *s && j != idx);
+            if mode == Mode::Strict && !signed[idx] && !vouched {
+                return Err(format!("input {idx} of {txid} is unsigned"));
+            }
+            let parent_unsigned = self.bundle.get(&prev.txid).is_some_and(|p| {
+                p.inputs.iter().all(|i| i.tap_key_sig.is_none() && i.tap_script_sigs.is_empty())
+            });
+            let parent_mode = if mode == Mode::LinkageOnly || (vouched && parent_unsigned) {
+                Mode::LinkageOnly
+            } else {
+                Mode::Strict
+            };
+            let (out, a) = if self.bundle.contains_key(&prev.txid) {
+                let a = self.check(prev.txid, parent_mode)?;
+                let out = self.bundle[&prev.txid]
+                    .unsigned_tx
+                    .output
+                    .get(prev.vout as usize)
+                    .cloned()
+                    .ok_or_else(|| format!("{prev} spent by {txid} does not exist"))?;
+                (out, a)
+            } else {
+                let (out, h) = self.mined_output(prev.txid, prev.vout)?;
+                (out, (prev.txid, h))
+            };
+            if anchor.map(|x| a.1 > x.1).unwrap_or(true) {
+                anchor = Some(a);
+            }
+            prevouts.push(out);
+        }
+        // signatures
+        let secp = ProofSecp::verification_only();
+        let mut cache = SighashCache::new(tx);
+        let mut operator_leaf = false;
+        for (idx, input) in psbt.inputs.iter().enumerate() {
+            let spk = &prevouts[idx].script_pubkey;
+            if let Some(sig) = input.tap_key_sig {
+                check_sighash_type(sig.sighash_type)?;
+                let h = cache
+                    .taproot_key_spend_signature_hash(idx, &Prevouts::All(&prevouts), sig.sighash_type)
+                    .map_err(|e| e.to_string())?;
+                verify_schnorr(&secp, &sig, h.to_byte_array(), &p2tr_key(spk)?)
+                    .map_err(|e| format!("{txid} input {idx} key-path: {e}"))?;
+            } else if !input.tap_script_sigs.is_empty() {
+                let out_key = p2tr_key(spk)?;
+                let mut ok_leaf = false;
+                for (cb, (script, ver)) in input.tap_scripts.iter() {
+                    let leaf = TapLeafHash::from_script(script, *ver);
+                    let pks = checksig_pubkeys(script);
+                    if pks.is_empty() || !pks.iter().all(|pk| input.tap_script_sigs.contains_key(&(*pk, leaf))) {
+                        continue;
+                    }
+                    if mode == Mode::Strict && !pks.iter().any(|k| self.operators.contains(k)) {
+                        // e.g. a user-only exit leaf: not an operator-acknowledged spend
+                        continue;
+                    }
+                    if !cb.verify_taproot_commitment(&secp, out_key, script) {
+                        return Err(format!("{txid} input {idx}: control block does not commit to the prevout key"));
+                    }
+                    for pk in &pks {
+                        let sig = input.tap_script_sigs[&(*pk, leaf)];
+                        check_sighash_type(sig.sighash_type)?;
+                        let h = cache
+                            .taproot_script_spend_signature_hash(idx, &Prevouts::All(&prevouts), leaf, sig.sighash_type)
+                            .map_err(|e| e.to_string())?;
+                        verify_schnorr(&secp, &sig, h.to_byte_array(), pk)
+                            .map_err(|e| format!("{txid} input {idx} script-path ({pk}): {e}"))?;
+                    }
+                    ok_leaf = true;
+                    operator_leaf = true;
+                    break;
+                }
+                if !ok_leaf {
+                    return Err(format!(
+                        "{txid} input {idx}: no fully signed tapleaf containing the operator key"
+                    ));
+                }
+            }
+        }
+        // [rgb-arkade] key-path only (e.g. any on-chain P2TR UTXO): the owner alone can sign it twice
+        if is_witness && mode == Mode::Strict && !operator_leaf {
+            return Err(format!("witness {txid} has no input co-signed by the operator"));
+        }
+        let anchor = anchor.ok_or_else(|| format!("{txid} has no inputs"))?;
+        self.memo.insert((txid, mode), anchor);
+        Ok(anchor)
+    }
+}
+
+/// Verify `proof` with only the blockchain `resolver`.
+pub(crate) fn verify_ark_proof<R: ResolveWitness>(
+    proof: &ArkProof,
+    resolver: &R,
+    operator_pubkey: &str,
+) -> Result<VerifiedArkWitnesses, String> {
+    Ok(verify_ark_proof_ext(proof, resolver, operator_pubkey, None)?.witnesses)
+}
+
+/// [rgb-arkade] Is `anchor` swept, i.e. spent on-chain (confirmed) by a tx other than its branch child?
+pub(crate) fn anchor_sweep(a: &ArkAnchor, spender: SpenderFn) -> Result<Option<String>, String> {
+    let op = ProofOutPoint::from_str(&a.outpoint).map_err(|e| e.to_string())?;
+    let spk = ProofScript::from_hex(&a.script_pubkey).map_err(|e| e.to_string())?;
+    Ok(match spender(op, &spk)? {
+        Some((s, true)) if s.to_string() != a.child => Some(s.to_string()),
+        _ => None,
+    })
+}
+
+/// [rgb-arkade] Verify `proof`, its `vtxos` branches and its `recoveries` (needs `spender`).
+pub(crate) fn verify_ark_proof_ext<R: ResolveWitness>(
+    proof: &ArkProof,
+    resolver: &R,
+    operator_pubkey: &str,
+    spender: Option<SpenderFn>,
+) -> Result<ArkProofVerified, String> {
+    // comma-separated hex keys (33-byte compressed or 32-byte x-only)
+    let mut operators = vec![];
+    for k in operator_pubkey.split(',').map(str::trim).filter(|k| !k.is_empty()) {
+        let b = hex::decode(k).map_err(|e| format!("operator key: {e}"))?;
+        let b = if b.len() == 33 { &b[1..] } else { &b[..] };
+        operators.push(ProofXOnly::from_slice(b).map_err(|e| format!("operator key: {e}"))?);
+    }
+    if operators.is_empty() {
+        return Err(s!("no operator key pinned"));
+    }
+    if proof.version != 1 {
+        return Err(format!("unsupported proof version {}", proof.version));
+    }
+    let mut bundle = HashMap::new();
+    for b64 in &proof.psbts {
+        let p = ProofPsbt::from_str(b64).map_err(|e| format!("invalid PSBT: {e}"))?;
+        bundle.insert(p.unsigned_tx.compute_txid(), p);
+    }
+    let mut witnesses = HashSet::new();
+    for w in &proof.witnesses {
+        witnesses.insert(ProofTxid::from_str(w).map_err(|e| e.to_string())?);
+    }
+    let mut v = Verifier { bundle, witnesses: witnesses.clone(), resolver, operators, memo: HashMap::new() };
+    let mut out = HashMap::new();
+    for w in witnesses {
+        let (anchor, _) = v.check(w, Mode::Strict)?;
+        let tx = v.bundle[&w].unsigned_tx.clone();
+        opret_layout_ok(&tx)?;
+        out.insert(w.to_string(), (tx, anchor.to_string()));
+    }
+    let mut vtxos = HashMap::new();
+    for o in &proof.vtxos {
+        let op = ProofOutPoint::from_str(o).map_err(|e| format!("vtxo {o}: {e}"))?;
+        if v.bundle.contains_key(&op.txid) {
+            v.check(op.txid, Mode::Strict)?;
+            if v.bundle[&op.txid].unsigned_tx.output.len() <= op.vout as usize {
+                return Err(format!("vtxo {o} does not exist"));
+            }
+            vtxos.insert(o.clone(), v.anchors(op.txid)?);
+        } else {
+            // already on-chain (unrolled)
+            v.mined_output(op.txid, op.vout)?;
+            vtxos.insert(o.clone(), (vec![], vec![]));
+        }
+    }
+    let mut recoveries = vec![];
+    for r in &proof.recoveries {
+        let fid = ProofTxid::from_str(r).map_err(|e| e.to_string())?;
+        if !out.contains_key(r) {
+            return Err(format!("recovery {r} is not a verified witness of the proof"));
+        }
+        let spender = spender.ok_or("recovery check needs chain access")?;
+        let psbt = &v.bundle[&fid];
+        let idx = psbt
+            .inputs
+            .iter()
+            .position(|i| !i.tap_script_sigs.is_empty())
+            .ok_or_else(|| format!("recovery {r}: no co-signed VTXO input"))?;
+        let vtxo = psbt.unsigned_tx.input[idx].previous_output;
+        if !v.bundle.contains_key(&vtxo.txid) {
+            return Err(format!(
+                "recovery forfeit {r}: VTXO {vtxo} is on-chain or its branch is missing, not a swept VTXO"
+            ));
+        }
+        let (anchors, _) = v.anchors(vtxo.txid)?;
+        let mut swept = None;
+        for a in &anchors {
+            if let Some(s) = anchor_sweep(a, spender)? {
+                swept = Some(s);
+                break;
+            }
+        }
+        match swept {
+            Some(s) => recoveries.push((r.clone(), s)),
+            None => {
+                return Err(format!(
+                    "recovery forfeit {r}: VTXO {vtxo} is not swept on-chain (anchors {:?} unspent or spent by the branch itself)",
+                    anchors.iter().map(|a| a.outpoint.clone()).collect::<Vec<_>>()
+                ));
+            }
+        }
+    }
+    Ok(ArkProofVerified { witnesses: out, vtxos, recoveries })
+}
+
+/// [rgb-arkade] Verify a fraud proof: both forfeits verify strictly (operator-co-signed VTXO input,
+/// linked to a mined commitment) and spend the same VTXO.
+pub(crate) fn verify_ark_fraud<R: ResolveWitness>(
+    f: &ArkFraudProof,
+    resolver: &R,
+    operator_pubkey: &str,
+) -> Result<ArkFraudEvidence, String> {
+    if f.version != 1 {
+        return Err(format!("unsupported fraud proof version {}", f.version));
+    }
+    if f.forfeit_a == f.forfeit_b {
+        return Err(s!("the two forfeits are the same tx"));
+    }
+    let vtxo = ProofOutPoint::from_str(&f.vtxo).map_err(|e| e.to_string())?;
+    let mut anchors = vec![];
+    let mut keys: Vec<String> = vec![];
+    for (fid, p) in [(&f.forfeit_a, &f.proof_a), (&f.forfeit_b, &f.proof_b)] {
+        let ver = verify_ark_proof(p, resolver, operator_pubkey)?;
+        let (tx, anchor) = ver.get(fid).ok_or_else(|| format!("forfeit {fid} not a witness of its proof"))?;
+        let psbt = p
+            .psbts
+            .iter()
+            .filter_map(|b| ProofPsbt::from_str(b).ok())
+            .find(|x| x.unsigned_tx.compute_txid().to_string() == *fid)
+            .ok_or_else(|| format!("forfeit {fid} PSBT missing"))?;
+        let idx = tx
+            .input
+            .iter()
+            .position(|i| i.previous_output == vtxo)
+            .ok_or_else(|| format!("forfeit {fid} does not spend {vtxo}"))?;
+        // the strict check above already required a fully signed leaf containing an operator key
+        let signers: Vec<String> = psbt.inputs[idx].tap_script_sigs.keys().map(|(pk, _)| pk.to_string()).collect();
+        if signers.is_empty() {
+            return Err(format!("forfeit {fid}: VTXO input not script-signed"));
+        }
+        keys.extend(signers);
+        anchors.push(anchor.clone());
+    }
+    let ops: Vec<String> = operator_pubkey
+        .split(',')
+        .filter_map(|k| hex::decode(k.trim()).ok())
+        .filter_map(|b| ProofXOnly::from_slice(if b.len() == 33 { &b[1..] } else { &b[..] }).ok())
+        .map(|k| k.to_string())
+        .collect();
+    keys.sort();
+    keys.dedup();
+    let operator_keys: Vec<String> = keys.into_iter().filter(|k| ops.contains(k)).collect();
+    if operator_keys.is_empty() {
+        return Err(s!("no pinned operator key signed the forfeits"));
+    }
+    Ok(ArkFraudEvidence {
+        vtxo: f.vtxo.clone(),
+        forfeits: [f.forfeit_a.clone(), f.forfeit_b.clone()],
+        anchors: [anchors[0].clone(), anchors[1].clone()],
+        operator_keys,
+    })
+}
