+    /// [rgb-arkade] Declare a tracked VTXO as owned by this wallet (e.g. own change or
+    /// own refresh output; received VTXOs are marked automatically). Untracked outpoints get a
+    /// record without anchors (liveness then unknown -> reported `Active`).
+    pub fn ark_set_vtxo_owned(&self, outpoint: String, owned: bool) -> Result<(), Error> {
+        let mut reg: HashMap<String, crate::ark_proof::ArkVtxoRecord> = self.ark_json_load(ARK_VTXOS_FILE);
+        reg.entry(outpoint.clone())
+            .or_insert_with(|| crate::ark_proof::ArkVtxoRecord { outpoint, anchors: vec![], branch: vec![], spent_by: None, owned })
+            .owned = owned;
+        self.ark_json_save(ARK_VTXOS_FILE, &reg)
+    }
+
+    /// [rgb-arkade] The custom-colored (Arkade) transfers this wallet made.
+    pub fn list_ark_transfers(&self) -> Result<Vec<crate::ark_proof::ArkTransferRecord>, Error> {
+        Ok(self.ark_json_load(ARK_TRANSFERS_FILE))
+    }
+
+    /// [rgb-arkade] rgb-lib marks a wallet UTXO spent only when it broadcasts the spending tx
+    /// itself; custom-colored txs go out through Arkade or the caller, so their wallet inputs are
+    /// marked here (and unmarked by a rollback), else the stock balance keeps counting them.
+    fn ark_set_txos_spent(&self, outpoints: &[String], spent: bool) -> Result<(), Error> {
+        let txn = self.database().begin_transaction()?;
+        for o in outpoints {
+            let Some((txid, vout)) = o.rsplit_once(':') else { continue };
+            let Ok(vout) = vout.parse::<u32>() else { continue };
+            if let Some(db_txo) = txn.get_txo(&Outpoint { txid: txid.to_string(), vout })? {
+                let mut db_txo: DbTxoActMod = db_txo.into();
+                db_txo.spent = ActiveValue::Set(spent);
+                txn.update_txo(db_txo)?;
+            }
+        }
+        txn.commit()?;
+        Ok(())
+    }
+
+    /// [rgb-arkade] Roll back a custom-colored transfer whose witness can never exist
+    /// (e.g. the forfeit of a failed batch): archive the witness in the RGB stock (its
+    /// assignments disappear, the consumed state is spendable again), un-mark the consumed
+    /// VTXOs and mark the log entry `rolled_back`. Refused if the witness is mined/in the
+    /// mempool or Ark-attested. The caller must know the batch failed (no operator co-signed
+    /// forfeit and no commitment tx can include it).
+    #[cfg(any(feature = "electrum", feature = "esplora"))]
+    pub fn ark_rollback_transfer(&self, online: Online, witness_txid: String) -> Result<(), Error> {
+        self.check_online(online)?;
+        if self.indexer().get_tx_confirmations(&witness_txid)?.is_some() {
+            return Err(Error::Internal { details: format!("{witness_txid} is known to the chain: cannot roll back") });
+        }
+        let wid = RgbTxid::from_str(&witness_txid).map_err(|_| Error::InvalidTxid)?;
+        if self.ark_attested_witnesses().contains_key(&wid) {
+            return Err(Error::Internal { details: format!("{witness_txid} is Ark-attested: cannot roll back") });
+        }
+        self.upsert_witness(wid, WitnessOrd::Archived)?;
+        let mut reg: HashMap<String, crate::ark_proof::ArkVtxoRecord> = self.ark_json_load(ARK_VTXOS_FILE);
+        for r in reg.values_mut() {
+            if r.spent_by.as_deref() == Some(witness_txid.as_str()) {
+                r.spent_by = None;
+            }
+        }
+        self.ark_json_save(ARK_VTXOS_FILE, &reg)?;
+        let mut log: Vec<crate::ark_proof::ArkTransferRecord> = self.ark_json_load(ARK_TRANSFERS_FILE);
+        for r in log.iter_mut() {
+            if r.witness == witness_txid {
+                r.status = s!("rolled_back");
+                self.ark_set_txos_spent(&r.inputs, false)?;
+            }
+        }
+        self.ark_json_save(ARK_TRANSFERS_FILE, &log)?;
+        info!(self.logger(), "Ark transfer {} rolled back", witness_txid);
+        Ok(())
+    }
+
+    /// [rgb-arkade] Verify a fraud proof (two operator-co-signed forfeits of the same
+    /// VTXO, each linked to a mined commitment tx) with the chain only.
+    #[cfg(any(feature = "electrum", feature = "esplora"))]
+    pub fn verify_ark_fraud_proof(&self, online: Online, path: PathBuf, operator_pubkey: String) -> Result<crate::ark_proof::ArkFraudEvidence, Error> {
+        self.check_online(online)?;
+        let content = fs::read_to_string(&path).map_err(|_| Error::InvalidFilePath { file_path: path.to_string_lossy().to_string() })?;
+        let f: crate::ark_proof::ArkFraudProof = serde_json::from_str(&content).map_err(|e| Error::Internal { details: format!("invalid fraud proof: {e}") })?;
+        crate::ark_proof::verify_ark_fraud(&f, self.blockchain_resolver(), &operator_pubkey)
+            .map_err(|details| Error::Internal { details: format!("fraud proof rejected: {details}") })
+    }
+
+    /// [rgb-arkade] Register a consensus-hex-encoded tx as an *Ark-attested* RGB witness.
+    ///
+    /// Use it for Arkade txs that legitimately close RGB seals but may never be mined, i.e. the
+    /// forfeit tx of a colored VTXO that was refreshed or collaboratively exited. The caller MUST
+    /// have verified it against the Ark layer first (operator `GetForfeitTxs` of a mined
+    /// commitment tx, connector input from that batch). All validation, acceptance and
+    /// `update_witnesses` calls of this wallet then resolve it as Tentative unless mined, and the
+    /// safe-height wait uses the confirmations of `anchor_txid` (the batch commitment tx).
+    /// Returns the txid.
+    pub fn add_ark_attested_witness(
+        &self,
+        tx_hex: String,
+        anchor_txid: String,
+    ) -> Result<String, Error> {
+        RgbTxid::from_str(&anchor_txid).map_err(|_| Error::InvalidTxid)?;
+        let bytes = hex::decode(&tx_hex).map_err(|e| Error::Internal {
+            details: format!("invalid tx hex: {e}"),
+        })?;
+        let tx: BdkTransaction = bdk_wallet::bitcoin::consensus::encode::deserialize(&bytes)
+            .map_err(|e| Error::Internal {
+                details: format!("invalid tx: {e}"),
+            })?;
+        let txid = tx.compute_txid().to_string();
+        let path = self.wallet_dir().join(ARK_ATTESTED_WITNESSES_FILE);
+        let mut map: HashMap<String, serde_json::Value> = fs::read_to_string(&path)
+            .ok()
+            .and_then(|c| serde_json::from_str(&c).ok())
+            .unwrap_or_default();
+        map.insert(
+            txid.clone(),
+            serde_json::json!({ "tx": tx_hex, "anchor": anchor_txid }),
+        );
+        fs::write(&path, serde_json::to_string_pretty(&map).unwrap()).map_err(|e| {
+            Error::Internal {
+                details: e.to_string(),
+            }
+        })?;
+        info!(self.logger(), "Added Ark-attested witness {}", txid);
+        Ok(txid)
+    }
