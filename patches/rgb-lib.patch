+    struct Mined(ProofTx);
+
+    impl ResolveWitness for Mined {
+        fn resolve_witness(&self, txid: RgbTxid) -> Result<WitnessStatus, WitnessResolverError> {
+            if txid.to_string() != self.0.compute_txid().to_string() {
+                return Ok(WitnessStatus::Unresolved);
+            }
+            let pos = WitnessPos::bitcoin(NonZeroU32::new(100).unwrap(), 1_700_000_000).unwrap();
+            Ok(WitnessStatus::Resolved(
