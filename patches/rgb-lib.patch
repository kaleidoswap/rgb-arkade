+            runtime.contract_assignments_for(contract_id, prev_outputs.iter().copied())?
+        {
+            for (opout, state) in opout_state_map {
+                if let AllocatedState::Amount(amt) = &state {
+                    available += amt.as_u64();
+                }
+                builder = builder.add_input(opout, state)?;
+            }
+        }
+        if available == 0 {
+            return Err(Error::InvalidColoringInfo {
+                details: s!("no asset allocation found on the PSBT inputs"),
+            });
+        }
+        let graph_seal = GraphSeal::with_blinding(seal_txid, seal_outpoint.vout, blinding);
+        builder = builder.add_fungible_state(
+            FieldName::from(RGB_STATE_ASSET_OWNER),
+            BuilderSeal::Revealed(graph_seal),
+            available,
+        )?;
+        let transition = builder.complete_transition()?;
+
+        let opreturn_index = psbt
+            .unsigned_tx
+            .output
+            .iter()
+            .position(|o| o.script_pubkey.is_op_return())
+            .unwrap();
+        let opreturn_output = psbt.outputs.get_mut(opreturn_index).unwrap();
+        opreturn_output.set_opret_host();
+        opreturn_output
+            .set_mpc_entropy(blinding)
+            .map_err(InternalError::from)?;
+        for opout in transition.inputs() {
+            psbt.set_rgb_contract_consumer(contract_id, opout, transition.id())
+                .map_err(InternalError::from)?;
+        }
+        psbt.push_rgb_transition(transition)
+            .map_err(InternalError::from)?;
+        psbt.set_rgb_close_method(CloseMethod::OpretFirst);
+        psbt.set_as_unmodifiable();
+        let fascia = psbt.rgb_commit().map_err(InternalError::from)?;
+        let witness_txid = psbt.get_txid();
+        runtime.consume_fascia(fascia, None)?;
+        let explicit = ExplicitSeal::with(seal_txid, seal_outpoint.vout);
+        let transfer = runtime.transfer(contract_id, vec![explicit], vec![], Some(witness_txid))?;
+        drop(runtime);
+        self.ark_set_txos_spent(&prev_outputs.iter().map(|o| o.to_string()).collect::<Vec<_>>(), true)?;
+        info!(self.logger(), "Color PSBT to explicit outpoint completed");
+        Ok(vec![transfer])
+    }
+
+    /// [rgb-arkade] Generic single-asset coloring with caller-chosen seals.
+    ///
+    /// All the `contract_id` state found on the PSBT inputs is moved to `beneficiaries`, each a
+    /// ([`SealTarget`], amount, blinding). [`SealTarget::WitnessVout`] uses the *exact* vout of
+    /// this PSBT (no `opreturn_first` shift), [`SealTarget::Explicit`] an external outpoint. The
+    /// amounts must add up to the input state. The PSBT must contain a bare OP_RETURN output (it
+    /// becomes the opret host). The fascia is consumed (Tentative) and one consignment covering
+    /// all the beneficiaries is returned.
+    pub fn color_psbt_and_consume_custom(
+        &self,
+        psbt: &mut Psbt,
+        contract_id: ContractId,
+        beneficiaries: Vec<(SealTarget, u64, u64)>,
+    ) -> Result<RgbTransfer, Error> {
+        info!(self.logger(), "Coloring PSBT with custom seals {:?}...", beneficiaries);
+        let opreturn_index = psbt
+            .unsigned_tx
+            .output
+            .iter()
+            .position(|o| o.script_pubkey.is_op_return())
+            .ok_or_else(|| Error::InvalidColoringInfo {
+                details: s!("PSBT must already contain an OP_RETURN output"),
+            })?;
+        let mut runtime = self.rgb_runtime()?;
+        let prev_outputs = psbt
+            .unsigned_tx
+            .input
+            .iter()
+            .map(|txin| txin.previous_output)
+            .collect::<HashSet<OutPoint>>();
+        let mut builder = runtime.transition_builder(contract_id, "transfer")?;
+        let mut available: u64 = 0;
+        for (_, opout_state_map) in
+            runtime.contract_assignments_for(contract_id, prev_outputs.iter().copied())?
+        {
+            for (opout, state) in opout_state_map {
+                if let AllocatedState::Amount(amt) = &state {
+                    available += amt.as_u64();
+                }
+                builder = builder.add_input(opout, state)?;
+            }
+        }
+        let requested: u64 = beneficiaries.iter().map(|(_, amt, _)| *amt).sum();
+        if available == 0 || requested != available {
+            return Err(Error::InvalidColoringInfo {
+                details: format!("input state {available} != requested {requested}"),
+            });
+        }
+        let mut explicit_targets = vec![];
+        let mut witness_vouts = vec![];
+        for (target, amount, blinding) in &beneficiaries {
+            let graph_seal = match target {
+                SealTarget::Explicit(outpoint) => {
+                    let txid = RgbTxid::from_str(&outpoint.txid).map_err(|_| Error::InvalidTxid)?;
+                    explicit_targets.push(ExplicitSeal::with(txid, outpoint.vout));
+                    GraphSeal::with_blinding(txid, outpoint.vout, *blinding)
+                }
+                SealTarget::WitnessVout(vout) => {
+                    if *vout as usize >= psbt.outputs.len() || *vout as usize == opreturn_index {
+                        return Err(Error::InvalidColoringInfo {
+                            details: format!("invalid witness vout {vout}"),
+                        });
+                    }
+                    witness_vouts.push(*vout);
+                    GraphSeal::with_blinded_vout(*vout, *blinding)
+                }
+            };
+            builder = builder.add_fungible_state(
+                FieldName::from(RGB_STATE_ASSET_OWNER),
+                BuilderSeal::Revealed(graph_seal),
+                *amount,
+            )?;
+        }
+        let transition = builder.complete_transition()?;
+
+        let mpc_entropy = beneficiaries.first().map(|(_, _, b)| *b).unwrap_or_default();
+        let opreturn_output = psbt.outputs.get_mut(opreturn_index).unwrap();
+        opreturn_output.set_opret_host();
+        opreturn_output
+            .set_mpc_entropy(mpc_entropy)
+            .map_err(InternalError::from)?;
+        for opout in transition.inputs() {
+            psbt.set_rgb_contract_consumer(contract_id, opout, transition.id())
+                .map_err(InternalError::from)?;
+        }
+        psbt.push_rgb_transition(transition)
+            .map_err(InternalError::from)?;
+        psbt.set_rgb_close_method(CloseMethod::OpretFirst);
+        psbt.set_as_unmodifiable();
+        let fascia = psbt.rgb_commit().map_err(InternalError::from)?;
+        let witness_txid = psbt.get_txid();
+        runtime.consume_fascia(fascia, None)?;
+        let mut seals = explicit_targets;
+        seals.extend(witness_vouts.into_iter().map(|v| ExplicitSeal::with(witness_txid, v)));
+        let transfer = runtime.transfer(contract_id, seals, vec![], Some(witness_txid))?;
+        drop(runtime);
+        // [rgb-arkade] log the custom-colored transfer and mark consumed tracked VTXOs
+        let inputs: Vec<String> = prev_outputs.iter().map(|o| o.to_string()).collect();
+        let outputs = beneficiaries
+            .iter()
+            .map(|(t, a, _)| match t {
+                SealTarget::Explicit(o) => (format!("{}:{}", o.txid, o.vout), *a),
+                SealTarget::WitnessVout(v) => (format!("{witness_txid}:{v}"), *a),
+            })
+            .collect();
+        let mut log: Vec<crate::ark_proof::ArkTransferRecord> = self.ark_json_load(ARK_TRANSFERS_FILE);
+        log.retain(|r| r.witness != witness_txid.to_string());
+        log.push(crate::ark_proof::ArkTransferRecord {
+            witness: witness_txid.to_string(),
+            asset_id: contract_id.to_string(),
+            inputs: inputs.clone(),
+            outputs,
+            created_at: std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .map(|d| d.as_secs())
+                .unwrap_or_default(),
+            status: s!("pending"),
+        });
+        self.ark_json_save(ARK_TRANSFERS_FILE, &log)?;
+        self.ark_set_txos_spent(&inputs, true)?;
+        let mut reg: HashMap<String, crate::ark_proof::ArkVtxoRecord> = self.ark_json_load(ARK_VTXOS_FILE);
+        for i in &inputs {
+            if let Some(r) = reg.get_mut(i) {
+                r.spent_by = Some(witness_txid.to_string());
+            }
+        }
+        self.ark_json_save(ARK_VTXOS_FILE, &reg)?;
+        info!(self.logger(), "Color PSBT with custom seals completed");
+        Ok(transfer)
+    }
+
+    /// [rgb-arkade] Like [`accept_transfer_consignment`](Wallet::accept_transfer_consignment)
+    /// but validating a consignment whose history contains a *chain* of offchain (Arkade
+    /// virtual) witnesses: every txid in `offchain_txids` is resolved from the bundled witness
+    /// as Tentative unless it is already mined, and so is every Ark-attested witness of this wallet
+    /// (see `ArkAwareResolver` and [`add_ark_attested_witness`](Wallet::add_ark_attested_witness)). The received seal
+    /// is `vout` of witness `txid` with the given `blinding`.
+    #[cfg(any(feature = "electrum", feature = "esplora"))]
+    pub fn accept_transfer_consignment_offchain(
+        &mut self,
+        online: Online,
+        consignment_path: PathBuf,
+        offchain_txids: Vec<String>,
+        txid: String,
+        vout: u32,
+        blinding: u64,
+    ) -> Result<(RgbTransfer, Vec<Assignment>), Error> {
+        info!(self.logger(), "Accepting offchain-chain transfer consignment...");
+        self.check_online(online)?;
+        let witness_id = RgbTxid::from_str(&txid).map_err(|_| Error::InvalidTxid)?;
+        let mut offchain_witnesses = HashSet::new();
+        for t in &offchain_txids {
+            offchain_witnesses.insert(RgbTxid::from_str(t).map_err(|_| Error::InvalidTxid)?);
+        }
+        let consignment =
+            RgbTransfer::load_file(&consignment_path).map_err(|_| Error::InvalidFilePath {
+                file_path: consignment_path.to_string_lossy().to_string(),
+            })?;
+        let asset_schema: AssetSchema = consignment.schema_id().try_into()?;
+        self.check_schema_support(&asset_schema)?;
+        let mut runtime = self.rgb_runtime()?;
+        runtime.store_secret_seal(GraphSeal::with_blinded_vout(vout, blinding))?;
+        // [rgb-arkade] offchain witnesses from the consignment + Ark-attested witnesses
+        let bundled: HashMap<RgbTxid, BdkTransaction> = consignment
+            .bundled_witnesses()
+            .filter(|bw| offchain_witnesses.contains(&bw.witness_id()))
+            .filter_map(|bw| bw.pub_witness.tx().cloned().map(|tx| (bw.witness_id(), tx)))
+            .collect();
+        let resolver = self.ark_aware_resolver(bundled);
+        let validation_config = ValidationConfig {
+            chain_net: self.chain_net(),
+            trusted_typesystem: asset_schema.types(),
+            ..Default::default()
+        };
+        let valid_consignment = match consignment.clone().validate(&resolver, &validation_config) {
+            Ok(consignment) => consignment,
+            Err(ValidationError::InvalidConsignment(e)) => {
+                error!(self.logger(), "Consignment is invalid: {}", e);
+                return Err(Error::InvalidConsignment);
+            }
+            Err(ValidationError::ResolverError(e)) => {
+                return Err(Error::Network {
+                    details: e.to_string(),
+                });
+            }
+        };
+        let valid_contract = valid_consignment.clone().into_valid_contract();
+        runtime
+            .import_contract(valid_contract, self.blockchain_resolver())
+            .expect("failure importing validated contract");
+        let received =
+            self.extract_received_assignments(&consignment, witness_id, Some(vout), None);
+        runtime.accept_transfer(valid_consignment, &resolver)?;
+        drop(runtime);
+        self.ark_set_vtxo_owned(format!("{txid}:{vout}"), true)?;
+        info!(self.logger(), "Accept offchain-chain transfer completed");
+        Ok((consignment, received.into_values().collect()))
+    }
+
+    /// [rgb-arkade] Validate a consignment file without accepting it, either with the
+    /// stock blockchain resolver (`ark_aware = false`) or with this wallet's Ark-aware resolver
+    /// (`ark_aware = true`, i.e. also resolving the Ark-attested witnesses). For tests.
+    #[cfg(any(feature = "electrum", feature = "esplora"))]
+    pub fn validate_consignment_ark(
+        &self,
+        online: Online,
+        consignment_path: PathBuf,
+        ark_aware: bool,
+    ) -> Result<(), Error> {
+        self.check_online(online)?;
+        let consignment =
+            RgbTransfer::load_file(&consignment_path).map_err(|_| Error::InvalidFilePath {
+                file_path: consignment_path.to_string_lossy().to_string(),
+            })?;
+        let asset_schema: AssetSchema = consignment.schema_id().try_into()?;
+        let validation_config = ValidationConfig {
+            chain_net: self.chain_net(),
+            trusted_typesystem: asset_schema.types(),
+            ..Default::default()
+        };
+        let res = if ark_aware {
+            consignment.validate(&self.ark_aware_resolver(HashMap::new()), &validation_config)
+        } else {
+            consignment.validate(self.blockchain_resolver(), &validation_config)
+        };
+        match res {
+            Ok(_) => Ok(()),
+            Err(ValidationError::InvalidConsignment(e)) => {
+                error!(self.logger(), "Consignment is invalid: {}", e);
+                Err(Error::InvalidConsignment)
+            }
+            Err(ValidationError::ResolverError(e)) => Err(Error::Network {
+                details: e.to_string(),
+            }),
+        }
+    }
+
+    /// [rgb-arkade] Verify a self-contained Ark proof (see [`crate::ark_proof`]) using only
+    /// the proof file and the blockchain (no arkd), then register every proven witness as
+    /// Ark-attested, anchored to its most recent mined ancestor. `operator_pubkey` is the pinned
+    /// Ark operator signer key (wallet config, hex). Returns the registered txids.
+    #[cfg(any(feature = "electrum", feature = "esplora"))]
+    pub fn import_ark_proof(
+        &self,
+        online: Online,
+        proof_path: PathBuf,
+        operator_pubkey: String,
+    ) -> Result<Vec<String>, Error> {
+        self.check_online(online)?;
+        let content = fs::read_to_string(&proof_path).map_err(|_| Error::InvalidFilePath {
+            file_path: proof_path.to_string_lossy().to_string(),
+        })?;
+        let proof: crate::ark_proof::ArkProof =
+            serde_json::from_str(&content).map_err(|e| Error::Internal {
+                details: format!("invalid Ark proof: {e}"),
+            })?;
+        let indexer = self.indexer();
+        let spender = |op: BdkOutPoint, spk: &ScriptBuf| indexer.spender_of(op, spk);
+        let verified = crate::ark_proof::verify_ark_proof_ext(
+            &proof,
+            self.blockchain_resolver(),
+            &operator_pubkey,
+            Some(&spender),
+        )
+        .map_err(|details| Error::Internal {
+            details: format!("Ark proof rejected: {details}"),
+        })?;
+        for (fid, sweep) in &verified.recoveries {
+            info!(self.logger(), "Ark proof: recovery forfeit {} accepted, branch swept by {}", fid, sweep);
+        }
+        // [rgb-arkade] track the bundled VTXOs (liveness from the chain)
+        let mut reg: HashMap<String, crate::ark_proof::ArkVtxoRecord> = self.ark_json_load(ARK_VTXOS_FILE);
+        for (o, (anchors, branch)) in verified.vtxos {
+            let spent_by = reg.get(&o).and_then(|r| r.spent_by.clone());
+            let owned = reg.get(&o).map(|r| r.owned).unwrap_or(false);
+            reg.insert(o.clone(), crate::ark_proof::ArkVtxoRecord { outpoint: o, anchors, branch, spent_by, owned });
+        }
+        self.ark_json_save(ARK_VTXOS_FILE, &reg)?;
+        let mut log: Vec<crate::ark_proof::ArkTransferRecord> = self.ark_json_load(ARK_TRANSFERS_FILE);
+        for r in log.iter_mut() {
+            if verified.witnesses.contains_key(&r.witness) && r.status == "pending" {
+                r.status = s!("attested");
+            }
+        }
+        self.ark_json_save(ARK_TRANSFERS_FILE, &log)?;
+        let mut done = vec![];
+        for (txid, (tx, anchor)) in verified.witnesses {
+            let hex = hex::encode(bdk_wallet::bitcoin::consensus::encode::serialize(&tx));
+            self.add_ark_attested_witness(hex, anchor.clone())?;
+            info!(self.logger(), "Ark proof: witness {} anchored to {}", txid, anchor);
+            done.push(txid);
+        }
+        done.sort();
+        Ok(done)
+    }
+
+    fn ark_json_load<T: serde::de::DeserializeOwned + Default>(&self, name: &str) -> T {
+        fs::read_to_string(self.wallet_dir().join(name))
+            .ok()
+            .and_then(|c| serde_json::from_str(&c).ok())
+            .unwrap_or_default()
+    }
+
+    fn ark_json_save<T: Serialize>(&self, name: &str, v: &T) -> Result<(), Error> {
+        let text = serde_json::to_string_pretty(v).map_err(|e| Error::Internal { details: e.to_string() })?;
+        fs::write(self.wallet_dir().join(name), text).map_err(|e| Error::Internal { details: e.to_string() })
+    }
+
+    /// [rgb-arkade] Liveness of a tracked colored VTXO, from the chain only (indexer):
+    /// swept branch -> `ToRecover`, mined VTXO tx -> `Unrolled`, consumed by this wallet ->
+    /// `Spent`, otherwise `Active`. The VTXO must have been tracked via an Ark proof `vtxos` entry.
+    #[cfg(any(feature = "electrum", feature = "esplora"))]
+    pub fn ark_vtxo_status(&self, online: Online, outpoint: String) -> Result<crate::ark_proof::ArkVtxoStatus, Error> {
+        self.check_online(online)?;
+        let reg: HashMap<String, crate::ark_proof::ArkVtxoRecord> = self.ark_json_load(ARK_VTXOS_FILE);
+        let rec = reg.get(&outpoint).ok_or_else(|| Error::Internal {
+            details: format!("VTXO {outpoint} is not tracked (import an Ark proof listing it)"),
+        })?;
+        self.ark_status_of(rec)
+    }
+
+    #[cfg(any(feature = "electrum", feature = "esplora"))]
+    fn ark_status_of(&self, rec: &crate::ark_proof::ArkVtxoRecord) -> Result<crate::ark_proof::ArkVtxoStatus, Error> {
+        use crate::ark_proof::ArkVtxoStatus;
+        if let Some(by) = &rec.spent_by {
+            return Ok(ArkVtxoStatus::Spent { by: by.clone() });
+        }
+        let txid = rec.outpoint.split(':').next().unwrap_or_default();
+        if let Some(c) = self.indexer().get_tx_confirmations(txid)? {
+            if c > 0 {
+                // unrolled; once its output is spent on-chain (e.g. an exit spend made with the
+                // stock coloring API, which does not touch this registry) the state has moved on
+                let op = BdkOutPoint::from_str(&rec.outpoint).map_err(|_| Error::InvalidTxid)?;
+                if let Some((by, _)) = self.indexer().spender_of_outpoint(op).map_err(|details| Error::Indexer { details })? {
+                    return Ok(ArkVtxoStatus::Spent { by: by.to_string() });
+                }
+                return Ok(ArkVtxoStatus::Unrolled);
+            }
+        }
+        let indexer = self.indexer();
+        let spender = |op: BdkOutPoint, spk: &ScriptBuf| indexer.spender_of(op, spk);
+        for a in &rec.anchors {
+            if let Some(s) = crate::ark_proof::anchor_sweep(a, &spender).map_err(|details| Error::Indexer { details })? {
+                return Ok(ArkVtxoStatus::ToRecover { sweep_txid: s });
+            }
+        }
+        Ok(ArkVtxoStatus::Active)
+    }
+
+    /// [rgb-arkade] Ark-aware balance of `asset_id`: the state this wallet's RGB stock
+    /// holds on tracked VTXOs, split by liveness (active / to recover / unrolled / in flight).
+    /// Unlike [`get_asset_balance`](Wallet::get_asset_balance) (DB, on-chain UTXOs only), a swept
+    /// VTXO is reported as `to_recover`, never as settled.
+    #[cfg(any(feature = "electrum", feature = "esplora"))]
+    pub fn get_asset_balance_ark(&self, online: Online, asset_id: String) -> Result<crate::ark_proof::ArkAssetBalance, Error> {
+        use crate::ark_proof::ArkVtxoStatus;
+        self.check_online(online)?;
+        let contract_id = ContractId::from_str(&asset_id).map_err(|_| Error::AssetNotFound { asset_id: asset_id.clone() })?;
+        let reg: HashMap<String, crate::ark_proof::ArkVtxoRecord> = self.ark_json_load(ARK_VTXOS_FILE);
+        let log: Vec<crate::ark_proof::ArkTransferRecord> = self.ark_json_load(ARK_TRANSFERS_FILE);
+        let pending: HashSet<String> = log.iter().filter(|r| r.status == "pending").map(|r| r.witness.clone()).collect();
+        let runtime = self.rgb_runtime()?;
+        let mut bal = crate::ark_proof::ArkAssetBalance::default();
+        let mut keys: Vec<&String> = reg.keys().collect();
+        keys.sort();
+        for o in keys {
+            let rec = &reg[o];
+            if !rec.owned {
+                continue;
+            }
+            let op = BdkOutPoint::from_str(o).map_err(|_| Error::InvalidTxid)?;
+            let amount: u64 = match runtime.contract_assignments_for(contract_id, [op]) {
+                Ok(m) => m
+                    .values()
+                    .flat_map(|x| x.values())
+                    .map(|st| if let AllocatedState::Amount(a) = st { a.as_u64() } else { 0 })
+                    .sum(),
+                Err(_) => 0,
+            };
+            if amount == 0 {
+                continue;
+            }
+            let st = self.ark_status_of(rec)?;
+            if let ArkVtxoStatus::Spent { by } = &st {
+                // the state left once the spending witness is attested (verified Ark proof) or
+                // mined (reconciled against the chain)
+                if !pending.contains(by) || self.indexer().get_tx_confirmations(by)?.is_some_and(|c| c > 0) {
+                    continue;
+                }
+            }
+            match &st {
+                ArkVtxoStatus::Active => bal.active += amount,
+                ArkVtxoStatus::Unrolled => bal.unrolled += amount,
+                ArkVtxoStatus::ToRecover { .. } => bal.to_recover += amount,
+                ArkVtxoStatus::Spent { .. } => bal.in_flight += amount,
+            }
+            bal.vtxos.push((o.clone(), amount, st));
+        }
+        Ok(bal)
+    }
+
+    /// [rgb-arkade] Accept a consignment that assigns state to an *explicit* VTXO seal
+    /// `outpoint` (refresh / recovery forfeit paying this wallet). Import the Ark proof first
+    /// (it attests the forfeit and tracks `outpoint`). Returns the amount received on it.
+    #[cfg(any(feature = "electrum", feature = "esplora"))]
+    pub fn ark_receive_vtxo_transfer(&mut self, online: Online, consignment_path: PathBuf, outpoint: String) -> Result<u64, Error> {
+        self.check_online(online)?;
+        let reg: HashMap<String, crate::ark_proof::ArkVtxoRecord> = self.ark_json_load(ARK_VTXOS_FILE);
+        if !reg.contains_key(&outpoint) {
+            return Err(Error::Internal { details: format!("VTXO {outpoint} is not tracked (import its Ark proof first)") });
+        }
+        let consignment = RgbTransfer::load_file(&consignment_path).map_err(|_| Error::InvalidFilePath {
+            file_path: consignment_path.to_string_lossy().to_string(),
+        })?;
+        let contract_id = consignment.contract_id();
+        let asset_schema: AssetSchema = consignment.schema_id().try_into()?;
+        self.check_schema_support(&asset_schema)?;
+        let resolver = self.ark_aware_resolver(HashMap::new());
+        let validation_config = ValidationConfig {
+            chain_net: self.chain_net(),
+            trusted_typesystem: asset_schema.types(),
+            ..Default::default()
+        };
+        let valid = match consignment.clone().validate(&resolver, &validation_config) {
+            Ok(c) => c,
+            Err(ValidationError::InvalidConsignment(e)) => {
+                error!(self.logger(), "Consignment is invalid: {}", e);
+                return Err(Error::InvalidConsignment);
+            }
+            Err(ValidationError::ResolverError(e)) => return Err(Error::Network { details: e.to_string() }),
+        };
+        let mut runtime = self.rgb_runtime()?;
