+/// [rgb-arkade] File (in the wallet dir) holding the Ark-attested witness txs.
+pub(crate) const ARK_ATTESTED_WITNESSES_FILE: &str = "ark_attested_witnesses.json";
+/// [rgb-arkade] tracked colored VTXOs
+pub(crate) const ARK_VTXOS_FILE: &str = "ark_vtxos.json";
+/// [rgb-arkade] custom-colored transfers log
+pub(crate) const ARK_TRANSFERS_FILE: &str = "ark_transfers.json";
+
+/// [rgb-arkade] Ark-aware witness resolver.
+///
+/// Arkade forfeit txs (and other virtual txs) can be legitimate RGB witnesses that are never
+/// mined: in the honest case the forfeited VTXO never reaches the chain, and if it does the
+/// operator broadcasts that very forfeit. For every txid in `attested` (txs the caller has
+/// verified against the Ark layer: listed by the operator for a *mined* commitment tx, spending a
+/// connector of that batch), a mined chain status wins; otherwise the tx is returned as
+/// [`WitnessOrd::Tentative`] instead of being unresolved (which would archive it and invalidate
+/// the whole history). Every other txid goes to the fallback unchanged.
+#[cfg(any(feature = "electrum", feature = "esplora"))]
+pub(crate) struct ArkAwareResolver<'a> {
+    pub(crate) attested: HashMap<RgbTxid, BdkTransaction>,
+    pub(crate) fallback: &'a AnyResolver,
+}
+
+#[cfg(any(feature = "electrum", feature = "esplora"))]
+impl ResolveWitness for ArkAwareResolver<'_> {
+    fn resolve_witness(&self, witness_id: RgbTxid) -> Result<WitnessStatus, WitnessResolverError> {
+        let Some(tx) = self.attested.get(&witness_id) else {
+            return self.fallback.resolve_witness(witness_id);
+        };
+        if let Ok(WitnessStatus::Resolved(tx, WitnessOrd::Mined(pos))) =
+            self.fallback.resolve_witness(witness_id)
+        {
+            return Ok(WitnessStatus::Resolved(tx, WitnessOrd::Mined(pos)));
+        }
+        Ok(WitnessStatus::Resolved(tx.clone(), WitnessOrd::Tentative))
+    }
+    fn check_chain_net(&self, chain_net: ChainNet) -> Result<(), WitnessResolverError> {
+        self.fallback.check_chain_net(chain_net)
+    }
+}
