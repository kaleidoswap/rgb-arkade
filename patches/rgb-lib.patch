+            Ok(())
+        }
+    }
+
+    fn tx(prev: ProofOutPoint, output: Vec<ProofTxOut>) -> ProofTx {
+        let input = vec![TxIn {
+            previous_output: prev,
+            script_sig: ProofScript::new(),
+            sequence: Sequence::MAX,
+            witness: Witness::new(),
+        }];
+        ProofTx {
+            version: Version::non_standard(3),
+            lock_time: LockTime::ZERO,
+            input,
+            output,
+        }
+    }
+
+    #[test]
+    fn key_path_only_witness_is_rejected() {
+        // an on-chain P2TR UTXO spent by a never-mined tx with a well-formed opret, no operator
+        let secp = ProofSecp::new();
+        let owner = Keypair::from_secret_key(&secp, &SecretKey::from_slice(&[2; 32]).unwrap());
+        let spk = ProofScript::new_p2tr(&secp, owner.x_only_public_key().0, None);
+        let prevout = ProofTxOut {
+            value: ProofAmount::from_sat(10_000),
+            script_pubkey: spk,
+        };
+        let parent = tx(
+            ProofOutPoint::new(ProofTxid::from_byte_array([1; 32]), 0),
+            vec![prevout.clone()],
+        );
+        let opret = ProofTxOut {
+            value: ProofAmount::ZERO,
+            script_pubkey: ProofScript::new_op_return([7; 32]),
+        };
+        let spend = tx(
+            ProofOutPoint::new(parent.compute_txid(), 0),
+            vec![opret, prevout.clone()],
+        );
+        let h = SighashCache::new(&spend)
+            .taproot_key_spend_signature_hash(
+                0,
+                &Prevouts::All(&[prevout]),
+                TapSighashType::Default,
+            )
+            .unwrap();
+        let signer = owner.tap_tweak(&secp, None).to_keypair();
+        let signature =
+            secp.sign_schnorr_no_aux_rand(&ProofMessage::from_digest(h.to_byte_array()), &signer);
+        let mut psbt = ProofPsbt::from_unsigned_tx(spend.clone()).unwrap();
+        psbt.inputs[0].tap_key_sig = Some(TapSig {
+            signature,
+            sighash_type: TapSighashType::Default,
+        });
+        let proof = ArkProof {
+            version: 1,
+            witnesses: vec![spend.compute_txid().to_string()],
+            psbts: vec![psbt.to_string()],
+            recoveries: vec![],
+            vtxos: vec![],
+        };
+        let operator = Keypair::from_secret_key(&secp, &SecretKey::from_slice(&[9; 32]).unwrap());
+        let err = verify_ark_proof(
+            &proof,
+            &Mined(parent),
+            &operator.x_only_public_key().0.to_string(),
+        )
+        .unwrap_err();
+        assert!(err.contains("no input co-signed by the operator"), "{err}");
+    }
+}
