+// [rgb-arkade patch 4] BuildForfeitTxWithOpReturn is BuildForfeitTx with an optional user
+// payload (e.g. an RGB opret commitment moving an asset from the forfeited VTXO to its
+// replacement). With a payload the outputs are [OP_RETURN <32B> (0 sat), forfeit, anchor]: the
+// OP_RETURN goes first because RGB opret1st requires it to precede any DBC-compatible (P2TR)
+// output. Without a payload the tx is identical to BuildForfeitTx.
+func BuildForfeitTxWithOpReturn(
+	inputs []*wire.OutPoint, sequences []uint32, prevouts []*wire.TxOut,
