+
+// CheckpointOpReturnSize is the only accepted size of a checkpoint OP_RETURN payload.
+const CheckpointOpReturnSize = 32
+
+// CheckpointOutputIndex returns the vout of the checkpoint output of a checkpoint tx: 1 if the
+// tx carries a user OP_RETURN (always placed first), 0 otherwise (upstream layout).
+func CheckpointOutputIndex(tx *wire.MsgTx) uint32 {
+	if len(tx.TxOut) > 1 && len(tx.TxOut[0].PkScript) > 0 &&
+		tx.TxOut[0].PkScript[0] == txscript.OP_RETURN {
+		return 1
+	}
+	return 0
+}
+
+// ExtractCheckpointOpReturn returns the payload of the optional user OP_RETURN of a checkpoint
+// tx (nil if there is none). It errors if the tx carries a malformed or extra OP_RETURN.
+func ExtractCheckpointOpReturn(tx *wire.MsgTx) ([]byte, error) {
+	var payload []byte
+	for i, out := range tx.TxOut {
+		if len(out.PkScript) == 0 || out.PkScript[0] != txscript.OP_RETURN {
+			continue
+		}
+		if payload != nil {
+			return nil, fmt.Errorf("checkpoint tx has more than one OP_RETURN output")
+		}
+		if out.Value != 0 || len(out.PkScript) != 2+CheckpointOpReturnSize ||
+			out.PkScript[1] != txscript.OP_DATA_32 {
+			return nil, fmt.Errorf("invalid checkpoint OP_RETURN output #%d", i)
+		}
+		payload = append([]byte{}, out.PkScript[2:]...)
+	}
+	return payload, nil
 }
 
