diff --git a/ark-client/src/coin_select.rs b/ark-client/src/coin_select.rs
index 67dedc0..60133a4 100644
--- a/ark-client/src/coin_select.rs
+++ b/ark-client/src/coin_select.rs
@@ -155,3 +155,109 @@ where
         selected_vtxo_outputs.into_iter().collect(),
     ))
 }
+
+/// [rgb-arkade] Select exactly `outpoints` (boarding outputs or unilaterally exited
+/// VTXOs of this wallet) as on-chain inputs, failing unless every one of them is confirmed, unspent
+/// and already claimable through the exit path.
+///
+/// [`coin_select_for_onchain`] stops as soon as the target amount is covered, so when several
+/// exited outputs pay the same contract it may pick any of them: e.g. unrolling a VTXO that came
+/// through a chain of Arkade txs also puts the owner's earlier (change) outputs of those txs
+/// on-chain, and they mature first. A caller that must spend a particular output (an RGB seal)
+/// has to name it.
+pub async fn coin_select_exact_for_onchain<B, W, S>(
+    client: &Client<B, W, S>,
+    outpoints: &[bitcoin::OutPoint],
+) -> Result<
+    (
+        Vec<unilateral_exit::OnChainInput>,
+        Vec<unilateral_exit::VtxoInput>,
+    ),
+    Error,
+>
+where
+    B: Blockchain,
+    W: OnchainWallet,
+    S: SwapStorage + 'static,
+{
+    let now: Duration = Timestamp::now()
+        .as_duration()
+        .try_into()
+        .map_err(Error::ad_hoc)?;
+    let mut onchain = Vec::new();
+    let mut vtxos = Vec::new();
+    let mut found = HashSet::new();
+    let mut pending = Vec::new();
+
+    for boarding_output in client.boarding_outputs()?.iter() {
+        for o in client
+            .blockchain()
+            .find_outpoints(boarding_output.address())
+            .await?
+        {
+            if !outpoints.contains(&o.outpoint) || o.is_spent || !found.insert(o.outpoint) {
+                continue;
+            }
+            match o.confirmation_blocktime {
+                Some(t)
+                    if boarding_output.can_be_claimed_unilaterally_by_owner(
+                        now,
+                        Duration::from_secs(t),
+                        o.confirmations,
+                    ) =>
+                {
+                    onchain.push(unilateral_exit::OnChainInput::new_with_spend_selection(
+                        boarding_output.exit_delay(),
+                        boarding_output.script_pubkey(),
+                        boarding_output.spend_selection(SpendPathKind::Exit)?,
+                        o.amount,
+                        o.outpoint,
+                    ));
+                }
+                _ => pending.push(o.outpoint),
+            }
+        }
+    }
+
+    for contract in client.active_offchain_contracts()? {
+        let vtxo = &contract.vtxo;
+        for o in client.blockchain().find_outpoints(vtxo.address()).await? {
+            if !outpoints.contains(&o.outpoint) || o.is_spent || !found.insert(o.outpoint) {
+                continue;
+            }
+            match o.confirmation_blocktime {
+                Some(t)
+                    if vtxo.can_be_claimed_unilaterally_by_owner(
+                        now,
+                        Duration::from_secs(t),
+                        o.confirmations,
+                    ) =>
+                {
+                    vtxos.push(unilateral_exit::VtxoInput::new_with_spend_selection(
+                        o.outpoint,
+                        vtxo.exit_delay(),
+                        TxOut {
+                            value: o.amount,
+                            script_pubkey: vtxo.script_pubkey(),
+                        },
+                        contract.spend_selection(SpendPathKind::Exit)?,
+                    ));
+                }
+                _ => pending.push(o.outpoint),
+            }
+        }
+    }
+
+    if !pending.is_empty() {
+        return Err(Error::coin_select(format!(
+            "outputs not claimable yet (exit delay): {pending:?}"
+        )));
+    }
+    let missing: Vec<_> = outpoints.iter().filter(|o| !found.contains(o)).collect();
+    if !missing.is_empty() {
+        return Err(Error::coin_select(format!(
+            "outputs not found among this wallet's unspent on-chain boarding/exited outputs: {missing:?}"
+        )));
+    }
+    Ok((onchain, vtxos))
+}
