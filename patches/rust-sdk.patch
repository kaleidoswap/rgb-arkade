+    /// [rgb-arkade] Build and sign (but do not broadcast) a transaction spending
+    /// unilaterally-exited VTXOs / boarding outputs on-chain, with `pre_outputs` placed first, an
+    /// explicit `fee`, and a `pre_sign_hook` run on the unsigned PSBT (used to RGB-color it).
+    ///
+    /// `inputs`: the exact outputs to spend (e.g. the RGB-colored exited VTXO); fails until all of
+    /// them are claimable. Empty: plain coin selection over every claimable output.
+    pub async fn create_send_on_chain_transaction_with_hook<H>(
+        &self,
+        to_address: Address,
+        to_amount: Amount,
+        pre_outputs: Vec<TxOut>,
+        fee: Amount,
+        inputs: &[bitcoin::OutPoint],
+        pre_sign_hook: H,
+    ) -> Result<(Transaction, Vec<TxOut>), Error>
+    where
+        H: FnOnce(&mut bitcoin::Psbt) -> Result<(), ark_core::Error>,
+    {
+        let pre_amount: Amount = pre_outputs.iter().map(|o| o.value).sum();
+        let (onchain_inputs, vtxo_inputs) = if inputs.is_empty() {
+            coin_select_for_onchain(self, to_amount + fee + pre_amount).await?
+        } else {
+            crate::coin_select::coin_select_exact_for_onchain(self, inputs).await?
+        };
+        let change_address = self.inner.wallet.get_onchain_address()?;
+        let sign = move |input: &mut psbt::Input, msg: bitcoin::secp256k1::Message| match &input
+            .witness_script
+        {
+            None => Err(ark_core::Error::ad_hoc("Missing witness script")),
+            Some(script) => {
+                let mut res = vec![];
+                for pk in extract_checksig_pubkeys(script) {
+                    if let Ok(keypair) = self.keypair_by_pk(&pk) {
+                        let sig = Secp256k1::new().sign_schnorr_no_aux_rand(&msg, &keypair);
+                        res.push((sig, keypair.x_only_public_key().0))
+                    }
+                }
+                Ok(res)
+            }
+        };
+        let tx = unilateral_exit::create_unilateral_exit_transaction_with_hook(
+            to_address,
+            to_amount,
+            change_address,
+            &onchain_inputs,
+            &vtxo_inputs,
+            pre_outputs,
+            fee,
+            pre_sign_hook,
+            sign,
+        )
+        .map_err(Error::from)?;
+        let prevouts = onchain_inputs
+            .iter()
+            .map(unilateral_exit::OnChainInput::previous_output)
+            .chain(vtxo_inputs.iter().map(unilateral_exit::VtxoInput::previous_output))
+            .collect();
+        Ok((tx, prevouts))
+    }
