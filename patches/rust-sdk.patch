+/// OP_RETURN (placed first), 0 otherwise (upstream layout).
+pub fn checkpoint_output_index(tx: &Transaction) -> usize {
+    match tx.output.first() {
+        Some(o) if tx.output.len() > 1 && o.script_pubkey.is_op_return() => 1,
+        _ => 0,
+    }
