+pub fn rgb_recovery_forfeit() -> bool {
+    RGB_RECOVERY_FORFEIT.load(std::sync::atomic::Ordering::SeqCst)
+}
+
+/// [rgb-arkade: threshold] Co-signing hook: called with every intent proof this process signs
+/// (`"intent"`, after its own signatures) and with every forfeit it signs in a batch
+/// (`"forfeit"`, after its own signatures, in `create_and_sign_forfeit_txs_with_hook`). A threshold delegate uses it to collect the other
+/// delegates' signatures (each checks the PSBT before adding its `tap_script_sigs`).
+pub type RgbCosignHook = std::sync::Arc<dyn Fn(&str, &mut Psbt) -> Result<(), Error> + Send + Sync>;
+
+static RGB_COSIGN: std::sync::Mutex<Option<RgbCosignHook>> = std::sync::Mutex::new(None);
+
+pub fn set_rgb_cosign(hook: Option<RgbCosignHook>) {
+    *RGB_COSIGN.lock().expect("cosign lock") = hook;
+}
+
+pub fn rgb_cosign(kind: &str, psbt: &mut Psbt) -> Result<(), Error> {
+    let hook = RGB_COSIGN.lock().expect("cosign lock").clone();
+    match hook {
+        Some(h) => h(kind, psbt),
+        None => Ok(()),
+    }
+}
