new file mode 100644
index 0000000..c1a316f
--- /dev/null
+++ b/internal/application/pending.go
@@ -0,0 +1,269 @@
+package application
+
+// [rgb] Durable finalize. A tx the emulator co-signed as finalizer is written to
+// $EMULATOR_DATADIR/pending/<txid>.json BEFORE arkd SubmitTx, and removed once arkd finalized it
+// (or holds nothing pending for it). After a crash, a restart, a failed finalize retry or a
+// "duplicated offchain tx" resubmit, completePending fetches arkd's checkpoint signatures with
+// GetPendingTx (intent proof signed by the emulator's tweaked key), merges them and finalizes.
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/arkade-os/arkd/pkg/ark-lib/intent"
+	"github.com/arkade-os/emulator/pkg/arkade"
+	"github.com/btcsuite/btcd/psbt/v2"
+	log "github.com/sirupsen/logrus"
+)
+
+var pendingResumeInterval = 10 * time.Second
+
+type pendingFill struct {
+	ArkTxid     string   `json:"ark_txid"`
+	ArkTx       string   `json:"ark_tx"`      // emulator-signed ark tx
+	Checkpoints []string `json:"checkpoints"` // emulator + co-signer signatures (no arkd signature)
+}
+
+type pendingStore struct {
+	dir  string
+	mu   sync.Mutex
+	busy map[string]bool
+}
+
+// newPendingStore returns nil (no persistence) when datadir is empty.
+func newPendingStore(datadir string) (*pendingStore, error) {
+	if datadir == "" {
+		return nil, nil
+	}
+	dir := filepath.Join(datadir, "pending")
+	if err := os.MkdirAll(dir, 0o700); err != nil {
+		return nil, err
+	}
+	return &pendingStore{dir: dir, busy: map[string]bool{}}, nil
+}
+
+func (p *pendingStore) path(txid string) string { return filepath.Join(p.dir, txid+".json") }
+
+// save writes atomically (temp file, fsync, rename, fsync dir).
+func (p *pendingStore) save(f pendingFill) error {
+	b, err := json.Marshal(f)
+	if err != nil {
+		return err
+	}
+	tmp := p.path(f.ArkTxid) + ".tmp"
+	fh, err := os.OpenFile(tmp, os.O_CREATE|os.O_WRONLY|os.O_TRUNC, 0o600)
+	if err != nil {
+		return err
+	}
+	if _, err := fh.Write(b); err != nil {
+		fh.Close()
+		return err
+	}
+	if err := fh.Sync(); err != nil {
+		fh.Close()
+		return err
+	}
+	if err := fh.Close(); err != nil {
+		return err
+	}
+	if err := os.Rename(tmp, p.path(f.ArkTxid)); err != nil {
+		return err
+	}
+	if d, err := os.Open(p.dir); err == nil {
+		_ = d.Sync()
+		d.Close()
+	}
+	return nil
+}
+
+func (p *pendingStore) remove(txid string) {
+	if err := os.Remove(p.path(txid)); err != nil && !os.IsNotExist(err) {
+		log.WithField("txid", txid).Warnf("failed to remove pending record: %s", err)
+	}
+}
+
+func (p *pendingStore) list() ([]pendingFill, error) {
+	names, err := filepath.Glob(filepath.Join(p.dir, "*.json"))
+	if err != nil {
+		return nil, err
+	}
+	out := make([]pendingFill, 0, len(names))
+	for _, n := range names {
+		b, err := os.ReadFile(n)
+		if err != nil {
+			return nil, err
+		}
+		var f pendingFill
+		if err := json.Unmarshal(b, &f); err != nil {
+			log.WithField("file", n).Warnf("skipping unreadable pending record: %s", err)
+			continue
+		}
+		out = append(out, f)
+	}
+	return out, nil
+}
+
+// claim marks txid as being handled (by a request or the resume loop); false if it already is.
+func (p *pendingStore) claim(txid string) bool {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.busy[txid] {
+		return false
+	}
+	p.busy[txid] = true
+	return true
+}
+
+func (p *pendingStore) release(txid string) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	delete(p.busy, txid)
+}
+
+// completePending finalizes a recorded tx. done: arkd finalized it now, or holds no pending tx
+// with this txid (never accepted, or already finalized), so the record can be dropped.
+func (s *service) completePending(ctx context.Context, f pendingFill) (bool, error) {
+	arkPtx, err := psbt.NewFromRawBytes(strings.NewReader(f.ArkTx), true)
+	if err != nil {
+		return true, fmt.Errorf("malformed recorded ark tx: %w", err)
+	}
+	cps := make([]*psbt.Packet, 0, len(f.Checkpoints))
+	for _, c := range f.Checkpoints {
+		cp, err := psbt.NewFromRawBytes(strings.NewReader(c), true)
+		if err != nil {
+			return true, fmt.Errorf("malformed recorded checkpoint: %w", err)
+		}
+		cps = append(cps, cp)
+	}
+	// an input this emulator signed: its checkpoint input proves ownership of the spent vtxo
+	packet, err := arkade.FindEmulatorPacket(arkPtx.UnsignedTx)
+	if err != nil {
+		return true, err
+	}
+	var owned *psbt.Packet
+	var scriptHash []byte
+	for _, entry := range packet {
+		for _, pk := range s.signerPubKeys {
+			script, err := arkade.ReadArkadeScript(arkPtx, pk, entry)
+			if err != nil {
+				continue
+			}
+			for _, cp := range cps {
+				if cp.UnsignedTx.TxHash() == arkPtx.UnsignedTx.TxIn[entry.Vin].PreviousOutPoint.Hash {
+					owned, scriptHash = cp, script.Hash()
+				}
+			}
+			break
+		}
+		if owned != nil {
+			break
+		}
+	}
+	if owned == nil {
+		return true, fmt.Errorf("no input of %s signed by this emulator", f.ArkTxid)
+	}
+	msg, err := intent.GetPendingTxMessage{
+		BaseMessage: intent.BaseMessage{Type: intent.IntentMessageTypeGetPendingTx},
+		ExpireAt:    time.Now().Add(2 * time.Minute).Unix(),
+	}.Encode()
+	if err != nil {
+		return false, err
+	}
+	in := owned.Inputs[0]
+	proof, err := intent.New(msg, []intent.Input{{
+		OutPoint:    &owned.UnsignedTx.TxIn[0].PreviousOutPoint,
+		Sequence:    owned.UnsignedTx.TxIn[0].Sequence,
+		WitnessUtxo: in.WitnessUtxo,
+	}}, nil)
+	if err != nil {
+		return false, err
+	}
+	for i := range proof.Inputs {
+		proof.Inputs[i].TaprootLeafScript = in.TaprootLeafScript
+	}
+	if err := s.Service.SignPendingTxProof(&proof.Packet, scriptHash); err != nil {
+		return false, err
+	}
+	encodedProof, err := proof.B64Encode()
+	if err != nil {
+		return false, err
+	}
+	pending, err := s.arkd.GetPendingTx(ctx, encodedProof, msg)
+	if err != nil {
+		return false, fmt.Errorf("get pending tx: %w", err)
+	}
+	var arkdCps []string
+	found := false
+	for _, p := range pending {
+		if p.Txid == f.ArkTxid {
+			arkdCps, found = p.SignedCheckpointTxs, true
+		}
+	}
+	if !found {
+		return true, nil
+	}
+	final := make([]string, 0, len(cps))
+	for _, cp := range cps {
+		for _, a := range arkdCps {
+			ap, err := psbt.NewFromRawBytes(strings.NewReader(a), true)
+			if err != nil {
+				return false, fmt.Errorf("malformed arkd checkpoint: %w", err)
+			}
+			if ap.UnsignedTx.TxHash() == cp.UnsignedTx.TxHash() && len(ap.Inputs) > 0 {
+				cp.Inputs[0].TaprootScriptSpendSig = mergeTapscriptSigs(
+					cp.Inputs[0].TaprootScriptSpendSig, ap.Inputs[0].TaprootScriptSpendSig,
+				)
+			}
+		}
+		enc, err := cp.B64Encode()
+		if err != nil {
+			return false, err
+		}
+		final = append(final, enc)
+	}
+	if err := s.arkd.FinalizeTx(ctx, f.ArkTxid, final); err != nil {
+		return false, fmt.Errorf("finalize: %w", err)
+	}
+	return true, nil
+}
+
+// resumeOne handles one record unless a request or another pass already does.
+func (s *service) resumeOne(ctx context.Context, f pendingFill) {
+	if !s.pending.claim(f.ArkTxid) {
+		return
+	}
+	defer s.pending.release(f.ArkTxid)
+	done, err := s.completePending(ctx, f)
+	if err != nil {
+		log.WithField("txid", f.ArkTxid).Warnf("pending tx: %s", err)
+	}
+	if done {
+		s.pending.remove(f.ArkTxid)
+		log.WithField("txid", f.ArkTxid).Info("pending tx resolved")
+	}
+}
+
+// resumePending runs at startup and then every pendingResumeInterval until ctx is done: this
+// replaces the in-memory finalize retry as the durable one.
+func (s *service) resumePending(ctx context.Context) {
+	for {
+		fills, err := s.pending.list()
+		if err != nil {
+			log.Warnf("failed to list pending txs: %s", err)
+		}
+		for _, f := range fills {
+			s.resumeOne(ctx, f)
+		}
+		select {
+		case <-ctx.Done():
+			return
+		case <-time.After(pendingResumeInterval):
+		}
+	}
+}
diff --git a/internal/application/pending_test.go b/internal/application/pending_test.go
new file mode 100644
index 0000000..95b488d
--- /dev/null
+++ b/internal/application/pending_test.go
@@ -0,0 +1,260 @@
+package application
+
+// [rgb] tests for the durable finalize (pending.go)
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/arkade-os/arkd/pkg/ark-lib/intent"
+	clientlib "github.com/arkade-os/arkd/pkg/client-lib"
+	"github.com/arkade-os/emulator/pkg/emulator"
+	"github.com/btcsuite/btcd/btcec/v2"
+	"github.com/btcsuite/btcd/psbt/v2"
+	"github.com/stretchr/testify/require"
+)
+
+// the plain fake holds nothing pending
+func (f *fakeArkd) GetPendingTx(context.Context, string, string) ([]clientlib.AcceptedOffchainTx, error) {
+	return nil, nil
+}
+
+// pendingArkd models arkd's pending-tx state on top of fakeArkd: an accepted tx stays pending
+// (its inputs locked) until finalized, a resubmit is "duplicated offchain tx", and GetPendingTx
+// requires a valid intent proof.
+type pendingArkd struct {
+	*fakeArkd
+	t            *testing.T
+	arkdPub      *btcec.PublicKey
+	recordPath   string
+	accepted     map[string][]string
+	loseResponse bool // accept, then fail the call (crash / connection lost)
+	proofs       int
+}
+
+func (p *pendingArkd) SubmitTx(ctx context.Context, arkTx string, cps []string) (string, string, []string, error) {
+	_, err := os.Stat(p.recordPath)
+	require.NoError(p.t, err, "record must be on disk before arkd sees the tx")
+	if _, ok := p.accepted[p.arkTxid]; ok {
+		return "", "", nil, fmt.Errorf("INVALID_ARK_PSBT (5): duplicated offchain tx")
+	}
+	txid, final, arkdCps, err := p.fakeArkd.SubmitTx(ctx, arkTx, cps)
+	if err != nil {
+		return "", "", nil, err
+	}
+	p.accepted[txid] = arkdCps
+	if p.loseResponse {
+		return "", "", nil, fmt.Errorf("connection lost")
+	}
+	return txid, final, arkdCps, nil
+}
+
+func (p *pendingArkd) FinalizeTx(ctx context.Context, txid string, cps []string) error {
+	if err := p.fakeArkd.FinalizeTx(ctx, txid, cps); err != nil {
+		return err
+	}
+	delete(p.accepted, txid)
+	return nil
+}
+
+func (p *pendingArkd) GetPendingTx(_ context.Context, proof, message string) ([]clientlib.AcceptedOffchainTx, error) {
+	p.proofs++
+	if err := intent.Verify(proof, message, []*btcec.PublicKey{p.arkdPub}); err != nil {
+		return nil, err
+	}
+	out := []clientlib.AcceptedOffchainTx{}
+	for txid, cps := range p.accepted {
+		out = append(out, clientlib.AcceptedOffchainTx{Txid: txid, SignedCheckpointTxs: cps})
+	}
+	return out, nil
+}
+
+func newPendingTestService(t *testing.T) (*service, emulator.OffchainTx, *pendingArkd, func() *service) {
+	t.Helper()
+	svc, tx, fake := newTestService(t, true)
+	fake.echoSigs = []bool{false} // arkd answers with only its own countersignature
+	fake.countersign = testArkdCountersig()
+	dir := t.TempDir()
+	store, err := newPendingStore(dir)
+	require.NoError(t, err)
+	svc.pending = store
+	arkd := &pendingArkd{
+		fakeArkd:   fake,
+		t:          t,
+		arkdPub:    svc.arkdPubKey,
+		recordPath: filepath.Join(dir, "pending", tx.ArkTx.UnsignedTx.TxID()+".json"),
+		accepted:   map[string][]string{},
+	}
+	svc.arkd = arkd
+	// restart: a new service on the same datadir and signer
+	restart := func() *service {
+		store, err := newPendingStore(dir)
+		require.NoError(t, err)
+		return &service{Service: svc.Service, arkd: arkd, indexer: svc.indexer,
+			arkdPubKey: svc.arkdPubKey, signerPubKeys: svc.signerPubKeys, pending: store}
+	}
+	return svc, tx, arkd, restart
+}
+
+func recordCount(t *testing.T, s *service) int {
+	t.Helper()
+	fills, err := s.pending.list()
+	require.NoError(t, err)
+	return len(fills)
+}
+
+// finalizedWithArkdSig: the last FinalizeTx got the checkpoints carrying arkd's countersignature
+func finalizedWithArkdSig(t *testing.T, a *pendingArkd) bool {
+	t.Helper()
+	require.NotEmpty(t, a.finalizePayloads)
+	cp, err := psbt.NewFromRawBytes(strings.NewReader(a.finalizePayloads[len(a.finalizePayloads)-1][0]), true)
+	require.NoError(t, err)
+	return hasSignature(cp.Inputs[0].TaprootScriptSpendSig, testArkdCountersig().Signature) &&
+		len(cp.Inputs[0].TaprootScriptSpendSig) >= 2
+}
+
+func shortFinalizeRetry(t *testing.T) {
+	orig := finalizeRetryConfig
+	finalizeRetryConfig = retryConfig{MinAttempts: 2, MaxAttempts: 2, InitialDelay: time.Millisecond, Multiplier: 1}
+	t.Cleanup(func() { finalizeRetryConfig = orig })
+}
+
+func TestPendingFinalize(t *testing.T) {
+	t.Run("record written before submit, removed after finalize", func(t *testing.T) {
+		svc, tx, arkd, _ := newPendingTestService(t)
+		_, err := svc.SubmitTx(t.Context(), tx)
+		require.NoError(t, err)
+		require.Equal(t, 1, arkd.submitCalls)
+		require.Equal(t, 1, arkd.finalizeCalls)
+		require.Empty(t, arkd.accepted)
+		require.Zero(t, recordCount(t, svc))
+	})
+
+	t.Run("finalize retries exhausted: record kept, resume loop finalizes", func(t *testing.T) {
+		shortFinalizeRetry(t)
+		svc, tx, arkd, _ := newPendingTestService(t)
+		arkd.finalizeErrs = []error{fmt.Errorf("unavailable"), fmt.Errorf("unavailable")}
+		_, err := svc.SubmitTx(t.Context(), tx)
+		require.Error(t, err)
+		require.Equal(t, 1, recordCount(t, svc))
+		require.Len(t, arkd.accepted, 1, "inputs locked in arkd")
+
+		ctx, cancel := context.WithCancel(t.Context())
+		cancel() // one pass
+		svc.resumePending(ctx)
+		require.Equal(t, 1, arkd.proofs)
+		require.Equal(t, 3, arkd.finalizeCalls)
+		require.True(t, finalizedWithArkdSig(t, arkd))
+		require.Empty(t, arkd.accepted)
+		require.Zero(t, recordCount(t, svc))
+	})
+
+	t.Run("crash after submit: restart finalizes from the record", func(t *testing.T) {
+		svc, tx, arkd, restart := newPendingTestService(t)
+		arkd.loseResponse = true
+		_, err := svc.SubmitTx(t.Context(), tx)
+		require.ErrorContains(t, err, "connection lost")
+		require.Zero(t, arkd.finalizeCalls)
+
+		svc2 := restart()
+		fills, err := svc2.pending.list()
+		require.NoError(t, err)
+		require.Len(t, fills, 1)
+		svc2.resumeOne(t.Context(), fills[0])
+		require.Equal(t, 1, arkd.finalizeCalls)
+		require.Equal(t, []string{tx.ArkTx.UnsignedTx.TxID()}, arkd.finalizeTxids)
+		require.True(t, finalizedWithArkdSig(t, arkd))
+		require.Empty(t, arkd.accepted)
+		require.Zero(t, recordCount(t, svc2))
+	})
+
+	t.Run("crash after submit: duplicated resubmit completes the tx", func(t *testing.T) {
+		svc, tx, arkd, restart := newPendingTestService(t)
+		resent := cloneOffchainTx(t, tx) // the client sends the same request again
+		arkd.loseResponse = true
+		_, err := svc.SubmitTx(t.Context(), tx)
+		require.Error(t, err)
+		tx = resent
+
+		arkd.loseResponse = false
+		svc2 := restart()
+		out, err := svc2.SubmitTx(t.Context(), tx)
+		require.NoError(t, err)
+		require.Equal(t, tx.ArkTx.UnsignedTx.TxHash(), out.ArkTx.UnsignedTx.TxHash())
+		require.Equal(t, 1, arkd.submitCalls) // the resubmit was rejected as duplicated
+		require.Equal(t, 1, arkd.finalizeCalls)
+		require.True(t, finalizedWithArkdSig(t, arkd))
+		require.Empty(t, arkd.accepted)
+		require.Zero(t, recordCount(t, svc2))
+	})
+
+	t.Run("never accepted by arkd: record dropped, nothing finalized", func(t *testing.T) {
+		svc, tx, arkd, restart := newPendingTestService(t)
+		arkd.submitErr = fmt.Errorf("arkd down")
+		_, err := svc.SubmitTx(t.Context(), tx)
+		require.Error(t, err)
+		require.Equal(t, 1, recordCount(t, svc))
+
+		svc2 := restart()
+		fills, err := svc2.pending.list()
+		require.NoError(t, err)
+		svc2.resumeOne(t.Context(), fills[0])
+		require.Equal(t, 1, arkd.proofs)
+		require.Zero(t, arkd.finalizeCalls)
+		require.Zero(t, recordCount(t, svc2))
+	})
+
+	t.Run("in-flight tx is not submitted twice", func(t *testing.T) {
+		svc, tx, arkd, _ := newPendingTestService(t)
+		require.True(t, svc.pending.claim(tx.ArkTx.UnsignedTx.TxID()))
+		_, err := svc.SubmitTx(t.Context(), tx)
+		require.ErrorContains(t, err, "already being finalized")
+		require.Zero(t, arkd.submitCalls)
+	})
+
+	t.Run("no datadir: no record, same behaviour", func(t *testing.T) {
+		store, err := newPendingStore("")
+		require.NoError(t, err)
+		require.Nil(t, store)
+	})
+}
+
+func TestSignPendingTxProofRejectsOtherIntents(t *testing.T) {
+	svc, tx, _, _ := newPendingTestService(t)
+	cp := tx.Checkpoints[0]
+	msg, err := intent.DeleteMessage{BaseMessage: intent.BaseMessage{Type: intent.IntentMessageTypeDelete}}.Encode()
+	require.NoError(t, err)
+	proof, err := intent.New(msg, []intent.Input{{
+		OutPoint:    &cp.UnsignedTx.TxIn[0].PreviousOutPoint,
+		Sequence:    cp.UnsignedTx.TxIn[0].Sequence,
+		WitnessUtxo: cp.Inputs[0].WitnessUtxo,
+	}}, nil)
+	require.NoError(t, err)
+	for i := range proof.Inputs {
+		proof.Inputs[i].TaprootLeafScript = cp.Inputs[0].TaprootLeafScript
+	}
+	err = svc.Service.SignPendingTxProof(&proof.Packet, []byte{1})
+	require.ErrorContains(t, err, "not a get-pending-tx intent proof")
+	for _, in := range proof.Inputs {
+		require.Empty(t, in.TaprootScriptSpendSig)
+	}
+}
+
+func cloneOffchainTx(t *testing.T, tx emulator.OffchainTx) emulator.OffchainTx {
+	t.Helper()
+	dec := func(p *psbt.Packet) *psbt.Packet {
+		c, err := psbt.NewFromRawBytes(strings.NewReader(encodePacket(t, p)), true)
+		require.NoError(t, err)
+		return c
+	}
+	out := emulator.OffchainTx{ArkTx: dec(tx.ArkTx)}
+	for _, cp := range tx.Checkpoints {
+		out.Checkpoints = append(out.Checkpoints, dec(cp))
+	}
+	return out
+}
