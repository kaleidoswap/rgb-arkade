+// checkpointOutputIndex mirrors arkd's offchain.CheckpointOutputIndex (checkpoint-opret patch).
+func checkpointOutputIndex(tx *wire.MsgTx) uint32 {
+	if len(tx.TxOut) > 1 && len(tx.TxOut[0].PkScript) > 0 && tx.TxOut[0].PkScript[0] == txscript.OP_RETURN {
