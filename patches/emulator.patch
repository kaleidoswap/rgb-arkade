diff --git a/pkg/emulator/pending_proof.go b/pkg/emulator/pending_proof.go
new file mode 100644
index 0000000..40e9d92
--- /dev/null
+++ b/pkg/emulator/pending_proof.go
@@ -0,0 +1,54 @@
+package emulator
+
+import (
+	"bytes"
+	"fmt"
+
+	"github.com/arkade-os/arkd/pkg/ark-lib/intent"
+	"github.com/arkade-os/emulator/pkg/arkade"
+	"github.com/btcsuite/btcd/btcec/v2/schnorr"
+	"github.com/btcsuite/btcd/psbt/v2"
+	"github.com/btcsuite/btcd/txscript/v2"
+)
+
+// SignPendingTxProof signs every input of a GetPendingTx intent proof with the signer key tweaked
+// by scriptHash. [rgb] The finalizer uses it after a crash to fetch arkd's checkpoint signatures
+// of a tx it submitted but did not finalize. Only proofs carrying a GetPendingTx message are
+// signed; such a proof spends a BIP-322 to_spend tx, so it can never be broadcast.
+func (s *service) SignPendingTxProof(proof *psbt.Packet, scriptHash []byte) error {
+	var msg intent.GetPendingTxMessage
+	var raw []byte
+	for _, u := range proof.Unknowns {
+		if bytes.Equal(u.Key, []byte{0x09}) {
+			raw = u.Value
+		}
+	}
+	if raw == nil || msg.Decode(string(raw)) != nil {
+		return fmt.Errorf("not a get-pending-tx intent proof")
+	}
+	fetcher := txscript.NewMultiPrevOutFetcher(nil)
+	for i, in := range proof.Inputs {
+		if in.WitnessUtxo == nil || len(in.TaprootLeafScript) != 1 {
+			return fmt.Errorf("intent proof input %d: missing witness utxo or leaf", i)
+		}
+		fetcher.AddPrevOut(proof.UnsignedTx.TxIn[i].PreviousOutPoint, in.WitnessUtxo)
+	}
+	for i, in := range proof.Inputs {
+		signed := false
+		for _, sg := range append([]signer{s.signer}, s.activeDeprecatedSigners()...) {
+			tweaked := arkade.ComputeArkadeScriptPublicKey(sg.secretKey.PubKey(), scriptHash)
+			if !bytes.Contains(in.TaprootLeafScript[0].Script, schnorr.SerializePubKey(tweaked)) {
+				continue
+			}
+			if err := sg.signInput(proof, i, scriptHash, fetcher); err != nil {
+				return fmt.Errorf("intent proof input %d: %w", i, err)
+			}
+			signed = true
+			break
+		}
+		if !signed {
+			return fmt.Errorf("intent proof input %d: leaf has no key of this signer", i)
+		}
+	}
+	return nil
+}
diff --git a/pkg/emulator/rgb_checkpoint_test.go b/pkg/emulator/rgb_checkpoint_test.go
new file mode 100644
index 0000000..5276211
--- /dev/null
+++ b/pkg/emulator/rgb_checkpoint_test.go
@@ -0,0 +1,70 @@
+package emulator
+
+// [rgb] checkpoint-opret layout: [OP_RETURN <32 bytes> (0 sat), checkpoint output, anchor],
+// the ark input spends vout 1 (arkd master + patches/arkd-checkpoint.patch).
+
+import (
+	"bytes"
+	"testing"
+
+	"github.com/btcsuite/btcd/txscript/v2"
+	"github.com/btcsuite/btcd/wire/v2"
+	"github.com/stretchr/testify/require"
+)
+
+// withCheckpointOpReturn inserts a data OP_RETURN at index 0 of the harness checkpoint
+// and repoints the ark input at the moved checkpoint output.
+func withCheckpointOpReturn(t *testing.T, h *submitTxHarness, value int64, payload []byte) {
+	t.Helper()
+	script, err := txscript.NullDataScript(payload)
+	require.NoError(t, err)
+	tx := h.checkpoint.UnsignedTx
+	tx.TxOut = append([]*wire.TxOut{{Value: value, PkScript: script}}, tx.TxOut...)
+	h.checkpoint.Outputs = append(h.checkpoint.Outputs, h.checkpoint.Outputs[0])
+	h.arkPtx.UnsignedTx.TxIn[0].PreviousOutPoint = wire.OutPoint{Hash: tx.TxHash(), Index: 1}
+}
+
+func TestSubmitTxCheckpointOpReturn(t *testing.T) {
+	commitment := bytes.Repeat([]byte{0xab}, 32)
+
+	t.Run("opret checkpoint, ark input on vout 1, is signed", func(t *testing.T) {
+		h := newSubmitTxHarness(t, tweakedArkd, tweakedArkd)
+		withCheckpointOpReturn(t, h, 0, commitment)
+		res, err := h.submit(t)
+		require.NoError(t, err)
+		require.Len(t, res.Checkpoints[0].Inputs[0].TaprootScriptSpendSig, 1)
+		require.NotEmpty(t, res.ArkTx.Inputs[0].TaprootScriptSpendSig)
+	})
+
+	t.Run("ark input spending the data output is rejected", func(t *testing.T) {
+		h := newSubmitTxHarness(t, tweakedArkd, tweakedArkd)
+		withCheckpointOpReturn(t, h, 0, commitment)
+		h.arkPtx.UnsignedTx.TxIn[0].PreviousOutPoint.Index = 0
+		_, err := h.submit(t)
+		require.Error(t, err)
+	})
+
+	t.Run("valued data output is rejected", func(t *testing.T) {
+		h := newSubmitTxHarness(t, tweakedArkd, tweakedArkd)
+		withCheckpointOpReturn(t, h, 1, commitment)
+		_, err := h.submit(t)
+		require.ErrorContains(t, err, "0-value OP_RETURN <32 bytes>")
+	})
+
+	t.Run("data output not 32 bytes is rejected", func(t *testing.T) {
+		h := newSubmitTxHarness(t, tweakedArkd, tweakedArkd)
+		withCheckpointOpReturn(t, h, 0, commitment[:20])
+		_, err := h.submit(t)
+		require.ErrorContains(t, err, "0-value OP_RETURN <32 bytes>")
+	})
+
+	t.Run("extra output after the anchor is rejected", func(t *testing.T) {
+		h := newSubmitTxHarness(t, tweakedArkd, tweakedArkd)
+		withCheckpointOpReturn(t, h, 0, commitment)
+		h.checkpoint.UnsignedTx.AddTxOut(&wire.TxOut{})
+		h.checkpoint.Outputs = append(h.checkpoint.Outputs, h.checkpoint.Outputs[0])
+		h.arkPtx.UnsignedTx.TxIn[0].PreviousOutPoint.Hash = h.checkpoint.UnsignedTx.TxHash()
+		_, err := h.submit(t)
+		require.ErrorContains(t, err, "one vtxo output and one anchor output")
+	})
+}
