+// IsDataOpReturn reports a 0-sat OP_RETURN <32B> data output (e.g. an RGB commitment in an ark
+// tx): a data output, never a (sub-dust) VTXO.
+func IsDataOpReturn(value int64, pkScript []byte) bool {
+	return value == 0 && len(pkScript) == 2+DataOpReturnSize &&
+		pkScript[0] == txscript.OP_RETURN && pkScript[1] == txscript.OP_DATA_32
+}
