+    /// [rgb-arkade] Arkade checkpoint look-through.
+    ///
+    /// A seal not spent by `witness` directly is treated as closed by it when the witness spends
+    /// output 0 of a resolved tx shaped like an Arkade checkpoint: one input spending the seal,
+    /// outputs `[P2TR, P2A anchor]`. The checkpoint is fixed by arkd and carries no commitment,
+    /// the ark tx spending it does. Only output 0 counts, so the anyone-can-spend anchor cannot
+    /// carry a competing commitment.
+    fn look_through(&self, seal: BlindSeal<Txid>, witness: &Tx) -> BlindSeal<Txid> {
+        let outpoint = bitcoin::OutPoint::new(seal.txid, seal.vout.into_u32());
+        if witness.input.iter().any(|i| i.previous_output == outpoint) {
+            return seal;
+        }
+        for input in witness.input.iter().filter(|i| i.previous_output.vout == 0) {
+            let cp_txid = input.previous_output.txid;
+            let Ok(WitnessStatus::Resolved(cp, ord)) = self.resolver.resolve_witness(cp_txid)
+            else {
+                continue;
+            };
+            let p2a = |s: &bitcoin::ScriptBuf| s.as_bytes() == [0x51, 0x02, 0x4e, 0x73];
+            if ord != WitnessOrd::Archived
+                && cp.input.len() == 1
+                && cp.input[0].previous_output == outpoint
+                && cp.output.len() == 2
+                && cp.output[0].script_pubkey.is_p2tr()
+                && p2a(&cp.output[1].script_pubkey)
+            {
+                return BlindSeal { txid: cp_txid, vout: crate::Vout::from_u32(0), ..seal };
+            }
+        }
+        seal
+    }
